+                k = 0, s = 0, state = 0, q = 0, sim = 0),
+            TelemRow(id = "x-nan", seq = 1, ts = today.startTs + 240, mono = 0, a = listOf(Double.NaN),
+                k = 0, s = 0, state = 0, q = 0, sim = 0)
+        )
+        val entry = TelemDayEntry(today, uniqueSortedRows(rows), today.startTs + 240)
