+// Pozostaly czas jako duration, niezalezny od zegara RTC telefonu. -1 oznacza
+// wyciszenie bez timera; 0 oznacza brak wyciszenia lub uplyniecie timera.
+long alarmWyciszeniePozostaloMs(bool wyciszony, uint32_t doMs) {
+  if (!wyciszony) return 0L;
+  if (doMs == 0) return -1L;
+  const int32_t left = static_cast<int32_t>(doMs - static_cast<uint32_t>(millis()));
+  return left > 0 ? static_cast<long>(left) : 0L;
+}
 
