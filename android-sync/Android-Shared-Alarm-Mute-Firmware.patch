+// Wspolna komenda z Androida: seconds=0 oznacza wyciszenie do ustapienia
+// biezacego alarmu, 1..3600 to timer, a "off" jawnie przywraca dzwiek.
+bool ustawWyciszenieAlarmu(const String& rodzaj, const String& akcja, String& blad) {
+  const bool wybierzDym = rodzaj == "dym" || rodzaj == "oba";
+  const bool wybierzOgrz = rodzaj == "ogrz" || rodzaj == "oba";
+  if (!wybierzDym && !wybierzOgrz) {
+    blad = "unknown_alarm_type";
+    return false;
+  }
+  const bool dymAktywny = czyAlarmAktywny == 1;
+  const bool ogrzAktywny = alarmOgrzewanieWlaczone || alarmPanelWlaczone;
+
+  if (akcja == "off") {
+    if (wybierzDym) {
+      czyDzwiekAlarmuWyciszony = false;
+      czyDzwiekAlarmuWyciszonyDoMs = 0;
+      fazaAlarmuDzwiekowego = 0;
+      if (dymAktywny) czasNastepnegoAlarmuDzwiekowego = millis();
+    }
+    if (wybierzOgrz) {
+      czyDzwiekAlarmuOgrzewaniaWyciszony = false;
+      czyDzwiekAlarmuOgrzewaniaWyciszonyDoMs = 0;
+      fazaAlarmuOgrzewania = 0;
+    }
+    zapiszLog(String(F("tag=ALARM akcja=koniec_wyciszenia rodzaj=")) + rodzaj);
+    return true;
+  }
+
+  if (akcja.isEmpty()) {
+    blad = "missing_duration";
+    return false;
+  }
+  for (size_t i = 0; i < akcja.length(); ++i) {
+    if (akcja[i] < '0' || akcja[i] > '9') {
+      blad = "invalid_duration";
+      return false;
+    }
+  }
+  const long seconds = akcja.toInt();
+  if (seconds < 0 || seconds > 3600) {
+    blad = "duration_out_of_range";
+    return false;
+  }
+
+  // "oba" jest atomowe: jesli jeden alarm zdazyl ustapic miedzy tapnieciem
+  // w telefonie a odbiorem komendy, wyciszamy tylko ten, ktory nadal trwa.
+  const bool wyciszDym = wybierzDym && dymAktywny;
+  const bool wyciszOgrz = wybierzOgrz && ogrzAktywny;
+  if (!wyciszDym && !wyciszOgrz) {
+    blad = "alarm_not_active";
+    return false;
+  }
+
+  const uint32_t doMs = seconds == 0 ? 0U
+      : static_cast<uint32_t>(millis()) + static_cast<uint32_t>(seconds) * 1000UL;
+  if (wyciszDym) {
+    czyDzwiekAlarmuWyciszony = true;
+    czyDzwiekAlarmuWyciszonyDoMs = doMs;
+    noTone(pinBuzer);
+    digitalWrite(pinZasilanieBuzera, LOW);
+    fazaAlarmuDzwiekowego = 0;
+  }
+  if (wyciszOgrz) {
+    czyDzwiekAlarmuOgrzewaniaWyciszony = true;
+    czyDzwiekAlarmuOgrzewaniaWyciszonyDoMs = doMs;
+    // Dym ma pierwszenstwo nad fizycznym buzzerem; nie przerywamy jego tonu.
+    if (czyAlarmAktywny != 1) {
+      noTone(pinBuzer);
+      digitalWrite(pinZasilanieBuzera, LOW);
+      fazaAlarmuOgrzewania = 0;
+    }
+  }
+  zapiszLog(String(F("tag=ALARM akcja=wyciszenie rodzaj=")) + rodzaj +
+      " czas_s=" + String(seconds));
+  return true;
+}
