+ */
+data class HistoryFetch(
+    val points: List<TelemPoint> = emptyList(),
+    val daysRequested: Int = 0,
+    val daysFromCache: Int = 0,
+    val daysDownloaded: Int = 0,
+    val daysStale: Int = 0,
