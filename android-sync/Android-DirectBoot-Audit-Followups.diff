diff --git a/android/app/src/test/java/com/sterownikco/pro/core/CommandRedactorTest.kt b/android/app/src/test/java/com/sterownikco/pro/core/CommandRedactorTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..36020871d08c85171b9e72e19c4e240968df0af5
--- /dev/null
+++ b/android/app/src/test/java/com/sterownikco/pro/core/CommandRedactorTest.kt
@@ -0,0 +1,33 @@
+package com.sterownikco.pro.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CommandRedactorTest {
+    @Test
+    fun redactsTelegramConfigurationPayloadFromDisplay() {
+        val raw = "tg_config 123456:placeholder-token 987654321 1"
+        val display = CommandRedactor.forDisplay(raw)
+
+        assertTrue(CommandRedactor.isSensitive(raw))
+        assertEquals("tg_config [dane poufne ukryte]", display)
+        assertFalse(display.contains("placeholder-token"))
+        assertFalse(display.contains("987654321"))
+    }
+
+    @Test
+    fun keepsOrdinaryCommandsUnchanged() {
+        val command = "pompa 1"
+
+        assertFalse(CommandRedactor.isSensitive(command))
+        assertEquals(command, CommandRedactor.forDisplay(command))
+    }
+
+    @Test
+    fun matchesTheVerbCaseInsensitivelyAndWithWhitespace() {
+        assertTrue(CommandRedactor.isSensitive("  TG_CONFIG\ttoken chat 1"))
+        assertFalse(CommandRedactor.isSensitive("tg_configure token chat 1"))
+    }
+}
