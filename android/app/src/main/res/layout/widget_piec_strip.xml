<?xml version="1.0" encoding="utf-8"?>
<!-- Szeroki, niski widżet: do czterech wybieranych temperatur w jednym wierszu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STEROWNIK CO"
            android:textColor="#EAF6FF"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="5dp"
            android:text="● LIVE"
            android:textColor="#4ADE80"
            android:textSize="7sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#7F93A3"
            android:textSize="7sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_cell_1"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="3dp" android:background="@drawable/widget_cell_bg"
            android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/w_l_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIEC" android:textColor="#8EA6BA" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_v_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_cell_2"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="2dp" android:background="@drawable/widget_cell_bg"
            android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/w_l_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BOJLER" android:textColor="#8EA6BA" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_v_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_cell_3"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginHorizontal="2dp" android:background="@drawable/widget_cell_bg"
            android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/w_l_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PANEL" android:textColor="#FFD32A" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_v_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFD32A" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_cell_4"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="3dp" android:background="@drawable/widget_cell_bg"
            android:gravity="center" android:orientation="vertical">
            <TextView android:id="@+id/w_l_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZEWN." android:textColor="#8EA6BA" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_v_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
