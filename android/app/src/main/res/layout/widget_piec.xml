<?xml version="1.0" encoding="utf-8"?>
<!-- Pełny widżet: cztery czujniki w czytelnej siatce 2×2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="STEROWNIK CO"
            android:textColor="#EAF6FF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="5dp"
            android:text="● LIVE"
            android:textColor="#4ADE80"
            android:textSize="8sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#7F93A3"
            android:textSize="8sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIEC C.O." android:textColor="#8EA6BA" android:textSize="8sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_t_ogrz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BOJLER C.W.U." android:textColor="#8EA6BA" android:textSize="8sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_t_bojler" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PANEL SŁONECZNY" android:textColor="#FFD32A" android:textSize="8sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_t_panel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFD32A" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ZEWNĘTRZNA" android:textColor="#8EA6BA" android:textSize="8sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_t_zewn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
