+
+  void CardReader::auto_start_cancel() {
+    if (!auto_start_armed) return;
+    auto_start_armed = false;
+    queue.clear();
+    queue.injected_commands_P = nullptr;
+    queue.injected_commands[0] = '\0';
+    thermalManager.setTargetBed(0);
+    set_bed_leveling_enabled(false);
+    ui.set_status(F("Start anulowany: pomiar"), true);
+    SERIAL_ERROR_MSG("SD start cancelled: heating or probing failed");
+  }
+
+  void CardReader::auto_preheat() {
+    if (!auto_start_armed) return;
+    thermalManager.setTargetBed(auto_bed_temp);
+    ui.set_status(F("Nagrzewanie stolu"));
+    const bool finished = thermalManager.wait_for_bed(false);
+    if (!finished || thermalManager.degTargetBed() != auto_bed_temp ||
+        fabsf(thermalManager.degBed() - auto_bed_temp) > 3.0f)
+      auto_start_cancel();
+  }
+
+  void CardReader::auto_prepare_probe() {
+    if (!auto_start_armed) return;
+    if (axes_should_home() || auto_grid_x != GRID_MAX_POINTS_X || auto_grid_y != GRID_MAX_POINTS_Y ||
+        auto_mesh_min_x != MESH_MIN_X || auto_mesh_max_x != MESH_MAX_X ||
+        auto_mesh_min_y != MESH_MIN_Y || auto_mesh_max_y != MESH_MAX_Y ||
+        thermalManager.degTargetBed() != auto_bed_temp || fabsf(thermalManager.degBed() - auto_bed_temp) > 3.0f) {
+      auto_start_cancel(); return;
+    }
+    GRID_LOOP(x, y) {
+      if ((auto_required(x, y) && !probe.can_reach(bedlevel.get_mesh_x(x), bedlevel.get_mesh_y(y))) ||
+          (!auto_required(x, y) && (!isfinite(bedlevel.z_values[x][y]) || fabsf(bedlevel.z_values[x][y]) > 10.0f))) {
+        auto_start_cancel(); return;
+      }
+    }
+    set_bed_leveling_enabled(false); // before invalidating any mesh points
+    GRID_LOOP(x, y) if (auto_required(x, y)) bedlevel.z_values[x][y] = NAN;
+  }
+
+  void CardReader::auto_probe_result() {
+    if (!auto_start_armed) return;
+    bool ok = !axes_should_home() && auto_grid_x == GRID_MAX_POINTS_X && auto_grid_y == GRID_MAX_POINTS_Y;
+    GRID_LOOP(x, y) if (auto_required(x, y) && !isfinite(bedlevel.z_values[x][y])) ok = false;
+    auto_probe_ok = ok;
+  }
+
+  void CardReader::auto_start_check() {
+    if (!auto_start_armed) return;
+    if (!auto_probe_ok || !bedlevel.mesh_is_valid() || axes_should_home()) {
+      auto_start_cancel();
+      return;
+    }
+    set_bed_leveling_enabled(true);
+    if (!planner.leveling_active) { auto_start_cancel(); return; }
+    auto_start_armed = false;
+  }
+#endif
