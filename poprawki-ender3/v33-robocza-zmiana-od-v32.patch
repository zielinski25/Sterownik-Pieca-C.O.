+  static uint8_t auto_grid_x, auto_grid_y;
+  static float auto_mesh_min_x, auto_mesh_max_x, auto_mesh_min_y, auto_mesh_max_y;
+  static bool auto_required(const int x, const int y) {
+    return x >= auto_ix0 && x <= auto_ix1 && y >= auto_iy0 && y <= auto_iy1;
