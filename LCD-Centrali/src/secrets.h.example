#pragma once
// =====================================================================
//  secrets.h  -  HASLA PANELU LCD. TEN PLIK NIE IDZIE DO GITA.
// =====================================================================
//
//  JAK ZACZAC (3 kroki):
//    1. Skopiuj ten plik i zmien nazwe kopii z "secrets.h.example" na "secrets.h"
//       (ten sam folder: src/).
//    2. Otworz "secrets.h" i wpisz hasla w miejsce tekstu w cudzyslowie.
//    3. Zapisz. Plik "secrets.h" jest w .gitignore - git go nie widzi.
//
//  To sa TE SAME dwie wartosci, ktore ma centrala w swoim secrets.h
//  (te same nazwy wpisow). Mozna tez po prostu skopiowac tutaj caly plik
//  secrets.h z projektu centrali - panel uzyje z niego tylko tych dwoch
//  wpisow.
//
//  Ten plik (.example) JEST w gicie i sluzy tylko jako wzor.
//  Nie wpisuj tu prawdziwych hasel - on idzie na GitHub.
// =====================================================================

// ----- 1. HASLO SIECI CENTRALI (PiecCO_AP) ----------------------------
// Musi byc IDENTYCZNE z SECRET_WIFI_AP_PASSWORD w secrets.h centrali,
// inaczej panel nie polaczy sie z centrala (w logu:
// "tag=WIFI ... zdarzenie=brak_polaczenia_na_starcie").
#define SECRET_WIFI_AP_PASSWORD "TU_WPISZ_HASLO_WIFI"      // min. 8 znakow

// ----- 2. HASLO OTA ---------------------------------------------------
// Musi byc IDENTYCZNE z SECRET_OTA_HASLO w secrets.h centrali - panel
// podaje je centrali, kiedy pobiera od niej swoj nowy firmware
// (GET /panel-ota.bin).
#define SECRET_OTA_HASLO        "TU_WPISZ_HASLO_OTA"
