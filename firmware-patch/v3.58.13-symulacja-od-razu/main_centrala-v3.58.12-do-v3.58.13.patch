+// [v3.58.13 SYM-OD-RAZU] Po starcie symulacji ("symuluj <pole> ..." z Firebase/LAN
+// albo /api/symulacja-czujnik ze starej strony) wartosc trafia do zmiennej
+// ODCZYTU od razu, a nie dopiero przy kolejnym odczycie czujnika z harmonogramu
+// (dsPlanInterval: bojler/panel co 60 s, zewn/pokoj co 120 s; DHT 120 s;
+// BMP280 180 s). Dotad status (/api/lan/status, /piec/status, LCD, Telegram)
+// przez 1-3 min pokazywal STARY odczyt przy aktywnej symulacji, a suwak w
+// panelu WWW po "Zastosuj" wracal do starej wartosci. Nastepny odczyt z
+// harmonogramu zwroci te sama symulowana wartosc (odczytajTemperature() przy
+// aktywnej symulacji nie dotyka filtra) - wiec to tylko przyspieszenie, nie
+// zmiana logiki. Zapis pojedynczego float jest atomowy na ESP32 (zadanie
+// czujnikow i tak nadpisuje te zmienne bez blokady). "dym" pomijamy: petla
+// czujnika dymu sama przepisuje symulowanyCzujnikDymu co kilka sekund.
+static void symulacjaUstawOdczytOdRazu(const String& pole, float wartosc) {
+  if      (pole == "ogrz")         temperaturaOgrzewania = wartosc;
+  else if (pole == "panel")        temperaturaPaneluSlonecznego = wartosc;
+  else if (pole == "bojler")       temperaturaBojlera = wartosc;
+  else if (pole == "pokoj")        temperaturaPomieszczenia = wartosc;
+  else if (pole == "zewn")         temperaturaNaZewnatrz = wartosc;
+  else if (pole == "ogrz_powrot")  temperaturaOgrzewania_Powrot = wartosc;
+  else if (pole == "ogrz_trociny") temperaturaOgrzewania_Trociny = wartosc;
+  else if (pole == "cisnienie")    cisnienieOdczytane = wartosc;
+  else if (pole == "wilgotnosc")   wilgotnoscOdczytana = wartosc;
+}
