+// [v3.58.20 DHT22-UJEMNE] Klony DHT22 koduja ujemne inaczej niz karta katalogowa
+// (znak-modul: bit 15 = minus, -0,1 = 0x8001), a biblioteka dekoduje wg karty:
+//   (a) U2 16-bit (-0,1 = 0xFFFF): biblioteka oddaje -3276,8 + |t|, czyli -0,1 C
+//       jako -3276,7, -40,0 C jako -3236,8  (Tasmota #14164, ESPHome #1744,
+//       Adafruit DHT #221, DHTNew #100 - najczestszy wariant z AliExpress);
+//   (b) U2 12-bit (-0,1 = 0x0FFF): biblioteka oddaje 409,6 - |t|, czyli -0,1 C
+//       jako +409,5, -40,0 C jako +369,6  (ESPHome #5322, PR #6074).
+// Oba przedzialy sa nieosiagalne dla prawdziwego DHT22 (-40..80 C), wiec
+// przeliczenie jest bezpieczne dla kazdego egzemplarza; zwykle wartosci
+// przechodza nietkniete. Zwraca true, gdy przeliczono (*wariant = 16 albo 12).
+static const float ZEW2_U2_BAZA_C   = 3276.8f;                // 0x8000 / 10
+static const float ZEW2_U2_MIN_C    = -3276.75f;              // obraz -0,1 C (z zapasem na float)
+static const float ZEW2_U2_MAX_C    = -3236.75f;              // obraz -40,0 C
+static const float ZEW2_U2_12_BAZA_C = 409.6f;                // 0x1000 / 10
+static const float ZEW2_U2_12_MIN_C  = 369.55f;               // obraz -40,0 C
+static const float ZEW2_U2_12_MAX_C  = 409.55f;               // obraz -0,1 C
+static bool zew2DekodujU2(float *t, uint8_t *wariant = nullptr) {
+  if (!isfinite(*t)) return false;
+  long dziesiate;                                              // |t| w 0,1 C: 1..400
+  if (*t >= ZEW2_U2_MIN_C && *t <= ZEW2_U2_MAX_C) {
+    dziesiate = lroundf((*t + ZEW2_U2_BAZA_C) * 10.0f);
+    if (wariant) *wariant = 16;
+  } else if (*t >= ZEW2_U2_12_MIN_C && *t <= ZEW2_U2_12_MAX_C) {
+    dziesiate = lroundf((ZEW2_U2_12_BAZA_C - *t) * 10.0f);
+    if (wariant) *wariant = 12;
+  } else {
+    return false;
+  }
+  *t = -(float)dziesiate / 10.0f;
+  return true;
+}
