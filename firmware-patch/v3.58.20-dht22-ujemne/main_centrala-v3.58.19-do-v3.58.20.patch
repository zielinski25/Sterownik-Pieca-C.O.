+// [v3.58.20 DHT22-UJEMNE] Klon DHT22 kodujacy ujemne w U2: biblioteka (znak-modul
+// wg karty katalogowej) oddaje -0,1 C jako -3276,7, -40,0 C jako -3236,8 (zawsze
+// -3276,8 + |t|). Taki odczyt przeliczamy na prawdziwa temperature; prawdziwy
+// DHT22 (bit znaku) nigdy nie zwroci wartosci z tego przedzialu, a zwykly
+// zakres -40..80 przechodzi nietkniety. Zwraca true, gdy przeliczono.
+static const float ZEW2_U2_BAZA_C = 3276.8f;                  // 0x8000 / 10
+static const float ZEW2_U2_MIN_C  = -3276.75f;                // obraz -0,1 C (z zapasem na float)
+static const float ZEW2_U2_MAX_C  = -3236.75f;                // obraz -40,0 C
+static bool zew2DekodujU2(float *t) {
+  if (!isfinite(*t) || *t < ZEW2_U2_MIN_C || *t > ZEW2_U2_MAX_C) return false;
+  const long dziesiate = lroundf((*t + ZEW2_U2_BAZA_C) * 10.0f);   // |t| w 0,1 C: 1..400
+  *t = -(float)dziesiate / 10.0f;
+  return true;
+}
