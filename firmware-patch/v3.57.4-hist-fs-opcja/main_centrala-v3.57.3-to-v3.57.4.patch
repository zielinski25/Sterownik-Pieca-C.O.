+// Po co: /hist_long.csv rosnie do ~1,8 MB (8000 probek), /hist_short.csv do
+// ~130 kB. Ktos, kto nie potrzebuje archiwum na flashu, moze je wylaczyc i
+// oszczedzic pamiec oraz cykle zapisu. Wylaczenie NIE dotyka telemetrii do
+// Firebase ani buforow w RAM - odcina wylacznie append do dwoch plikow.
+//
+// Stan: NVS namespace "hist". Brak klucza = WLACZONE (tak jak dotad).
+// ═══════════════════════════════════════════════════════════════════════════
+static std::atomic<bool> g_histFsZapisWlaczony{true};
+
+bool historiaZapisNaFsWlaczony() {
+  return g_histFsZapisWlaczony.load(std::memory_order_acquire);
+}
+
+static bool historiaFsZapiszNvs(bool wlaczony) {
+  Preferences p;
+  if (!p.begin("hist", false)) return false;
+  const bool ok = (p.putBool("fs_on", wlaczony) == sizeof(uint8_t));
+  p.end();
+  return ok;
+}
+
+static bool historiaFsCzyscZapiszNvs(bool zadane) {
+  Preferences p;
+  if (!p.begin("hist", false)) return false;
+  const bool ok = (p.putBool("czysc", zadane) == sizeof(uint8_t));
+  p.end();
+  return ok;
+}
+
+// Zwraca true, gdy stan trafil do NVS (przetrwa restart).
+bool historiaFsUstaw(bool wlaczony) {
+  g_histFsZapisWlaczony.store(wlaczony, std::memory_order_release);
+  const bool nvs = historiaFsZapiszNvs(wlaczony);
+  if (wlaczony) DLOG(DC_HISTORIA, DL_INFO, F("HIST-FS zdarzenie=wlaczony msg=\"zapis historii na flash przywrocony\""));
+  else          DLOG(DC_HISTORIA, DL_INFO, F("HIST-FS zdarzenie=wylaczony msg=\"zapis historii na flash zatrzymany, RAM i Firebase bez zmian\""));
+  return nvs;
+}
+
+// Znacznik czyszczenia - pliki znikna przy najblizszym starcie.
