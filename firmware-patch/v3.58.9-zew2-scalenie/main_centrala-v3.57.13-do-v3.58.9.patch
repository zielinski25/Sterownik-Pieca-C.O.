+static int startTgDopisek(char* buf, size_t n, bool czekaNaPotw, unsigned potwMin) {
+  if (!czekaNaPotw) { if (n) buf[0] = '\0'; return 0; }
+  return snprintf(buf, n, " Nowy program czeka na potwierdzenie: %u min stabilnej pracy z WiFi; "
+                          "potem przyjdzie \"Aktualizacja zakonczona pomyslnie\" albo ostrzezenie.", potwMin);
