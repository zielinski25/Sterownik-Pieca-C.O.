+//   poOta/otaTag - w NVS jest otaSelfTrwa=true z tagiem (restart po /update)
+static int startTgTresc(char* buf, size_t n, const char* wersja, uint32_t boot, esp_reset_reason_t powod,
+                        bool poOta, const char* otaTag) {
+  const bool tagJest = poOta && otaTag != nullptr && otaTag[0] != '\0';
+  return snprintf(buf, n, "Centrala wystartowala: %s (boot=%lu). Powod restartu: %s%s%s%s%s.",
+                  wersja, (unsigned long)boot, startTgPowodOpis(powod),
