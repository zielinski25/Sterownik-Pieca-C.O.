+static TagcheckRodzaj tagcheckRodzaj(int porownanie) {
+  if (porownanie == 0) return TAGCHECK_ZGODNA;
+  return porownanie < 0 ? TAGCHECK_BINARKA_STARSZA : TAGCHECK_BINARKA_NOWSZA;
+}
+static int tagcheckTresc(char* buf, size_t n, TagcheckRodzaj rodzaj, const char* tag, const char* dziala) {
+  switch (rodzaj) {
+    case TAGCHECK_BINARKA_STARSZA:
+      return snprintf(buf, n,
+        "UWAGA: aktualizacja \"powiodla sie\" (flash + restart bez bledu), ale dziala wersja %s, "
+        "a mial byc zainstalowany %s. Binarka w Release %s jest STARSZA niz jego tag: zostala skompilowana "
+        "PRZED podniesieniem FIRMWARE_VERSION w kodzie. Popraw kod (FIRMWARE_VERSION = v%s), skompiluj od nowa "
+        "i podmien firmware.bin w Release %s. Do tego czasu /update bedzie w kolko probowal to samo.",
+        dziala, tag, tag, tag, tag);
+    case TAGCHECK_BINARKA_NOWSZA:
+      return snprintf(buf, n,
+        "Aktualizacja wgrana i dziala wersja %s - NOWSZA niz tag Release (%s), z ktorego ja pobrano. "
+        "Kod jest dobry; za maly numer ma Release na GitHub (binarka %s opublikowana pod tagiem %s). "
+        "Popraw tag i nazwe Release na numer dzialajacej wersji (%s, bez \"v\" - jak dotychczasowe tagi; ten sam firmware.bin). Petli nie bedzie: /update odmowi "
+        "(tag starszy niz dzialajaca wersja), ale do poprawki nie zobaczy tez zadnej nowszej wersji.",
+        dziala, tag, dziala, tag, dziala);
+    default:
+      return snprintf(buf, n, "Aktualizacja zakonczona pomyslnie. Dziala wersja: %s", dziala);
+  }
+}
