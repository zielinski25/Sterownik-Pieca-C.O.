+  TAGCHECK_BINARKA_STARSZA,   // Release X, dziala < X: nie podbito FIRMWARE_VERSION przed kompilacja
+  TAGCHECK_BINARKA_NOWSZA,    // Release X, dziala > X: Release ma za maly numer (19.11: tag 3.58.5, dziala 3.58.6)
+};
