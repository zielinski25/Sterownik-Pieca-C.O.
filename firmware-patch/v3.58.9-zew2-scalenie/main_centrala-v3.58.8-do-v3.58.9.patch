+static float g_tempDhtDiag = NAN;
+static uint64_t g_tempDhtAtUs = 0;
+static void zapiszTempDiag(float v) {
+  const uint64_t at = (uint64_t)esp_timer_get_time();
+  portENTER_CRITICAL(&g_tempDiagMux);
+  g_tempDhtDiag = v; g_tempDhtAtUs = at;
+  portEXIT_CRITICAL(&g_tempDiagMux);
+}
+static float czytajTempDiag() {
+  float v; uint64_t at;
+  portENTER_CRITICAL(&g_tempDiagMux);
+  v = g_tempDhtDiag; at = g_tempDhtAtUs;
+  portEXIT_CRITICAL(&g_tempDiagMux);
+  const uint64_t now = (uint64_t)esp_timer_get_time();
+  return isfinite(v) && now >= at && now - at <= 135000000ULL ? v : NAN;
+}
+static String jsonTempDiag() {
+  const float v = czytajTempDiag();
+  return isfinite(v) ? String(v, 1) : String("null");
+}
