+// Odczyt gotowych zapisow LittleFS. Bez zapisu i bez pobierania Firebase.
+var _solarNumerPobrania=0;
+function solarDataPoprawna(s){
+  if(!/^\d{4}-\d{2}-\d{2}$/.test(s)) return false;
+  var dt=new Date(s+'T00:00:00Z'); return Number.isFinite(dt.getTime()) && dt.toISOString().slice(0,10)===s;
+}
+function solarWartosc(x,jednostka, digits){
+  var n=wykrLiczba(x); return Number.isFinite(n) ? n.toFixed(digits)+' '+jednostka : 'brak';
+}
+function solarLinia(host, text){
+  var el=document.createElement('div'); el.className='row-desc'; el.textContent=text; host.appendChild(el);
+}
+function solarPokazRekord(host, r){
+  var karta=document.createElement('div'); karta.className='karta'; host.appendChild(karta);
+  var t=document.createElement('h2'); t.textContent='Dzien '+(typeof r.localDate==='string' && solarDataPoprawna(r.localDate) ? r.localDate : 'nieznany'); karta.appendChild(t);
+  var f=r.forecast && typeof r.forecast==='object' ? r.forecast : {};
+  var a=r.actual && typeof r.actual==='object' ? r.actual : {};
+  if(f.available===true){
+    var godz=wykrLiczba(f.hourCount);
+    var ghi=Number.isFinite(godz) && godz>0 ? solarWartosc(f.sumGhiKwhM2,'kWh/m²',2) : 'brak';
+    solarLinia(karta,'Prognoza GHI centrali: '+ghi+
+      ' | godziny: '+solarWartosc(f.hourCount,'',0)+' / '+solarWartosc(f.expectedHours,'',0)+
+      ' | '+(f.complete===true?'pelna':f.complete===false?'niepelna':'kompletnosc nieznana')+
+      (f.capturedLate===true?' | pobrana po czasie':'')+'.');
+    if(typeof f.capturedAtUtc==='string' && f.capturedAtUtc) solarLinia(karta,'Prognoza zapisana: '+f.capturedAtUtc+' (UTC).');
+  } else solarLinia(karta,'Prognoza GHI: brak zapisanej prognozy w centrali.');
+  var wersja=wykrLiczba(r.schemaVersion);
+  // Schema v1 w bazie centrali dotyczyla bojlera pieca, NIE zbiornika solarnego.
+  if(!Number.isFinite(wersja) || wersja<2 || a.channel!=='t_panel'){
+    solarLinia(karta,'Stary lub nieznany kanal rekordu: danych zbiornika nie prezentujemy jako solarnych.');
+  } else if(a.available!==true){
+    solarLinia(karta,'Zbiornik solarny: brak zapisanego pomiaru.');
+  } else {
+    var wystarczajaco=wykrLiczba(a.validSamples)>=2;
+    solarLinia(karta,'Zbiornik solarny (t_panel), zmiana w dniu: '+(wystarczajaco ? solarWartosc(a.deltaC,'°C',1) : 'brak (mniej niz 2 probki)')+
+      ' | pierwszy: '+solarWartosc(a.firstC,'°C',1)+' | ostatni: '+solarWartosc(a.lastC,'°C',1)+'.');
+    var ratio=wykrLiczba(a.coverageRatio);
+    var pokrycie=Number.isFinite(ratio) && ratio>=0 && ratio<=1 ? (ratio*100).toFixed(1)+'%' : 'brak';
+    solarLinia(karta,'Probki poprawne: '+solarWartosc(a.validSamples,'',0)+' | oczekiwane minuty: '+solarWartosc(a.expectedSampleCount,'',0)+
+      ' | symulowane: '+solarWartosc(a.simulatedSamples,'',0)+' | niepoprawne: '+solarWartosc(a.invalidSamples,'',0)+
+      ' | pokrycie minut: '+pokrycie+' | '+(a.complete===true?'pokrycie pelne':a.complete===false?'pokrycie niepelne':'kompletnosc nieznana')+
+      ' | '+(a.finalized===true?'dzien zamkniety':'dzien niezamkniety lub stan nieznany')+'.');
+    solarLinia(karta,'Ekwiwalent 100 l: '+(wystarczajaco ? solarWartosc(a.equivalent100lKwh,'kWh',2) : 'brak (mniej niz 2 probki)')+
+      ' — szacunek zmiany energii wody, NIE pomiar uzysku ani oddanej energii.');
+  }
+  if(typeof r.updatedAtUtc==='string' && r.updatedAtUtc) solarLinia(karta,'Ostatni zapis rekordu: '+r.updatedAtUtc+' (UTC).');
+}
+function solarPobierz(){
+  var nr=++_solarNumerPobrania, host=document.getElementById('solarDni'), msg=document.getElementById('solarStatus');
+  var input=document.getElementById('solarData'), data=input ? input.value : '';
+  if(!host || !msg) return;
+  host.textContent='';
+  if(data && !solarDataPoprawna(data)){msg.textContent='Nieprawidlowa data.';return;}
+  msg.textContent='Odczyt z centrali...';
+  fetch('/api/solar-archive'+(data?'?date='+encodeURIComponent(data):''),{cache:'no-store'})
+    .then(function(r){if(!r.ok) throw Error('HTTP');return r.json();})
+    .then(function(j){
+      if(nr!==_solarNumerPobrania) return;
+      if(!j || j.ok!==true || !Array.isArray(j.days)) throw Error('odpowiedz');
+      var days=j.days.filter(function(r){return r && typeof r==='object' && (!data || r.localDate===data);});
+      if(!days.length){msg.textContent='Brak zapisanego rekordu dla wybranego okresu lub brak czasu centrali.';return;}
+      msg.textContent='Zapis lokalny centrali; dane aktualne na czas podany w rekordzie. Domyslnie dzis i wczoraj wedlug centrali.';
+      days.forEach(function(r){solarPokazRekord(host,r);});
+    }).catch(function(){if(nr===_solarNumerPobrania){host.textContent='';msg.textContent='Nie udalo sie odczytac archiwum solarnego z centrali.';}});
+}
