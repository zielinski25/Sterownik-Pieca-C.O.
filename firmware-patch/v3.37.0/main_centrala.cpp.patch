+int32_t alarmMuteRemainingMs(AlarmMuteTimer& mute, bool alarmActive) {
+  int32_t remaining = 0;
+  portENTER_CRITICAL(&alarmMuteMux);
+  if (mute.active) {
+    if (mute.untilClear) {
+      if (alarmActive) {
+        remaining = -1;
+      } else {
+        mute.active = false;
+        mute.untilClear = false;
+        mute.startedAtMs = 0;
+        mute.durationMs = 0;
+      }
+    } else {
+      uint32_t elapsed = (uint32_t)(millis() - mute.startedAtMs);
+      if (elapsed >= mute.durationMs) {
+        mute.active = false;
+        mute.startedAtMs = 0;
+        mute.durationMs = 0;
+      } else {
+        remaining = (int32_t)(mute.durationMs - elapsed);
+      }
+    }
+  }
+  portEXIT_CRITICAL(&alarmMuteMux);
+  return remaining;
+}
