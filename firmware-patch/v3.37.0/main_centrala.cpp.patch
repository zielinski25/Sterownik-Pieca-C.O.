+static bool obsluzKomendeAlarmMute(const String& cmd, String& blad) {
+  if (!cmd.startsWith("alarm_mute ")) { blad = "nieznana_komenda"; return false; }
+  String args = cmd.substring(11);
+  args.trim();
+  int separator = args.indexOf(' ');
+  if (separator < 0) { blad = "format: alarm_mute <dym|ogrz|oba> <sekundy|off>"; return false; }
+  String target = args.substring(0, separator);
+  String action = args.substring(separator + 1);
+  action.trim();
+  if (action.length() == 0 || action.indexOf(' ') >= 0) {
+    blad = "format: alarm_mute <dym|ogrz|oba> <sekundy|off>";
+    return false;
+  }
+  bool dymTarget = (target == "dym" || target == "oba");
+  bool ogrzTarget = (target == "ogrz" || target == "oba");
+  if (!dymTarget && !ogrzTarget) { blad = "cel musi byc dym, ogrz albo oba"; return false; }
+
+  if (action == "off") {
+    if (dymTarget) alarmMuteClear(alarmMuteDym);
+    if (ogrzTarget) alarmMuteClear(alarmMuteOgrz);
+    if (dymTarget && czyAlarmAktywny == 1) {
+      fazaAlarmuDzwiekowego = 0;
+      czasNastepnegoAlarmuDzwiekowego = millis();
+    }
+    zapiszLog(String(F("tag=ALARM akcja=wyciszenie_zmieniono cel=")) + target + " tryb=off");
+    return true;
+  }
+
+  for (unsigned int i = 0; i < action.length(); ++i) {
+    if (action[i] < '0' || action[i] > '9') { blad = "czas musi byc liczba sekund albo off"; return false; }
   }
+  long seconds = action.toInt();
+  if (seconds < 0 || seconds > 3600) { blad = "czas wyciszenia poza zakresem 0-3600 s"; return false; }
+  bool aktywnyCel = (dymTarget && czyAlarmAktywny == 1) ||
+                    (ogrzTarget && (alarmOgrzewanieWlaczone || alarmPanelWlaczone));
+  if (seconds == 0 && !aktywnyCel) { blad = "brak aktywnego alarmu do wyciszenia do skasowania"; return false; }
+
+  if (dymTarget) alarmMuteSet(alarmMuteDym, (int)seconds);
+  if (ogrzTarget) alarmMuteSet(alarmMuteOgrz, (int)seconds);
+  alarmMuteStopSoundIfOwned(dymTarget, ogrzTarget);
+  if (seconds == 0) {
+    zapiszLog(String(F("tag=ALARM akcja=wyciszenie_zmieniono cel=")) + target + " tryb=do_skasowania");
+  } else {
+    zapiszLog(String(F("tag=ALARM akcja=wyciszenie_zmieniono cel=")) + target + " sekundy=" + String(seconds));
+  }
+  return true;
 }
 
