+    out = linia;
+    return 200;
+  }
+
+  // Okno [poczatek, poczatek + rozpietosc): konczy sie sekunde po najnowszej probce.
+  const uint32_t koniecOkna = tMax + 1U;
+  uint32_t poczatek = (koniecOkna > okno) ? (koniecOkna - okno) : 0U;
+  if (poczatek < tMin) poczatek = tMin;
