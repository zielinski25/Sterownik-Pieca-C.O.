+    if (dl >= sizeof(linia)) { ok = false; break; }   // nie powinno sie zdarzyc: 400 B to z zapasem najdluzszy wiersz
+    ok = out.concat(linia);
+  }
+  free(kub);
+  if (ok) {
+    snprintf(linia, sizeof(linia), "#koniec %d\n", n);
+    ok = out.concat(linia);
+  }
+  if (!ok) { out = "brak pamieci\n"; return 503; }
+  DLOGF(DC_HISTORIA, DL_INFO, "PANEL_WYKRES tryb=%s pkt=%d wierszy=%d punktow=%d przerw=%d bajtow=%u",
+        tryb, pkt, wierszy, n - przerw, przerw, (unsigned)out.length());
+  return 200;
+}
