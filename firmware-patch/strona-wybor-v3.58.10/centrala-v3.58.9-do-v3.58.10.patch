+<script>
+// Wybor otwartego widoku jest wspolny dla calej centrali, nie localStorage.
+// Kolejka zapobiega wyscigowi miedzy automatycznym zgloszeniem a kliknieciem.
+(function(){
+  let kolejka = Promise.resolve();
+  async function zapisz(widok) {
+    const r = await fetch('/api/wybor-strony-token', {cache:'no-store'});
+    if (!r.ok) throw new Error('Nie mozna pobrac tokenu');
+    const j = await r.json();
+    const post = await fetch('/api/wybor-strony', {
+      method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
+      body:'widok='+encodeURIComponent(widok)+'&token='+encodeURIComponent(j.token)
+    });
+    if (!post.ok) throw new Error('Nie mozna zapisac wyboru ('+post.status+')');
+  }
+  function ustaw(widok) {
+    const praca = kolejka.catch(()=>{}).then(()=>zapisz(widok));
+    kolejka = praca; return praca;
+  }
+  window.zmienWyborStrony = function(widok, url) {
+    ustaw(widok).then(()=>{window.location.href=url;}).catch(()=>{
+      alert('Nie udalo sie zapisac wyboru strony w centrali. Sprobuj ponownie.');
+    });
+  };
+  window.addEventListener('pageshow', function(){
+    if (location.pathname === '/stara') ustaw('stara').catch(()=>{});
+    else if (location.pathname === '/nowa' || location.pathname === '/') ustaw('nowa').catch(()=>{});
+  });
+})();
+</script>
