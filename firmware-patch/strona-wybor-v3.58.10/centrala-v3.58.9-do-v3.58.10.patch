+static WyborStrony g_wyborStrony;
+static SemaphoreHandle_t g_wyborStronyMutex = nullptr;
+// Uruchamiane raz przed startem serwera. Namespace i klucze ponizej 15 znakow.
+static void wyborStronyInit() {
+  g_wyborStronyMutex = xSemaphoreCreateMutex();
+  Preferences p;
+  if (p.begin("wyborwww", false)) {
+    g_wyborStrony.przywroc(p.getUChar("strona", 0));
+    p.end();
+  } else {
+    DLOG(DC_WEB, DL_ERR, F("WYBOR-STRONY zdarzenie=nvs_odczyt_blad"));
+  }
