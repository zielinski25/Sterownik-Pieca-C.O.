+void scenariuszWersjaStart() {
+  g_atrapa.eter.push_back(ap(BSSID_PIEC, 6, -45, 0));
+  setup();
+  bool wersja = false, naglowek = false;
+  for (const std::string& napis : g_atrapa.napisyTft) {
+    if (napis == WERSJA_FW) wersja = true;
+    if (napis == "Panel LCD") naglowek = true;
+  }
+  sprawdz(wersja && naglowek, "ekran startowy wypisal numer dzialajacego firmware panelu");
+  sprawdz(g_atrapa.wdtZadzialal == 0, "watchdog nie zadzialal podczas wyswietlania wersji");
+  biegnij(3000);
+  sprawdz(kopia(0).nStatus > 0, "po ekranie startowym panel laczy sie z centrala");
+}
