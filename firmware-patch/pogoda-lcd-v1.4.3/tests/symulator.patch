+const lv_img_dsc_t* zewnObraz() {
+  lv_obj_t* label = znajdzEtykiete(lv_scr_act(), "ZEWN");
+  if (!label) return nullptr;
+  lv_obj_t* card = lv_obj_get_parent(label);
+  for (uint32_t i = 0; i < lv_obj_get_child_cnt(card); ++i) {
+    lv_obj_t* o = lv_obj_get_child(card, i);
+    if (lv_obj_check_type(o, &lv_img_class)) return (const lv_img_dsc_t*) lv_img_get_src(o);
+  }
+  return nullptr;
+}
+bool zewnJest(const lv_img_dsc_t& oczekiwany) {
+  const auto* r = zewnObraz();
+  return r && r->data_size == oczekiwany.data_size && memcmp(r->data, oczekiwany.data, r->data_size) == 0;
+}
+void scenariuszPogoda() {
+  using namespace PogodaIkony;
+  g_atrapa.eter.push_back(ap(BSSID_PIEC, 6, -45, 0));
+  setup(); biegnij(4000);
+  sprawdz(zewnJest(ikona_nieznana), "starsza centrala: brak pogody = pytajnik");
+  ustaw(0, [](Centrala& c) { c.pogodaExtra = ",\"pogoda_kod\":0,\"pogoda_dzien\":true"; });
+  biegnij(3000); sprawdz(zewnJest(ikona_slonce), "status 0 dzien: slonce");
+  ustaw(0, [](Centrala& c) { c.pogodaExtra = ",\"pogoda_kod\":0,\"pogoda_dzien\":false"; });
+  biegnij(3000); sprawdz(zewnJest(ikona_ksiezyc), "status 0 noc: ksiezyc");
+  ustaw(0, [](Centrala& c) { c.pogodaExtra = ",\"pogoda_kod\":95,\"pogoda_dzien\":true"; });
+  biegnij(3000); sprawdz(zewnJest(ikona_burza), "status 95: burza");
+  ustaw(0, [](Centrala& c) { c.pogodaExtra = ",\"pogoda_kod\":null,\"pogoda_dzien\":null"; });
+  biegnij(3000); sprawdz(zewnJest(ikona_nieznana), "status null: pytajnik");
+  ustaw(0, [](Centrala& c) { c.pogodaExtra = ",\"pogoda_kod\":0,\"pogoda_dzien\":1"; });
+  biegnij(3000); sprawdz(zewnJest(ikona_nieznana), "bledny typ dnia: pytajnik");
+}
