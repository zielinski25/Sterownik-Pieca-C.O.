
#include <string>
#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <cmath>
struct String {
  std::string v;
  String(){} String(const char*c):v(c){} String(const std::string&x):v(x){}
  int indexOf(const char*n,int from=0)const{ if(from<0||from>(int)v.size())return -1; size_t p=v.find(n,from); return p==std::string::npos?-1:(int)p;}
  int indexOf(const String&n,int from=0)const{return indexOf(n.v.c_str(),from);}
  int indexOf(char c,int from=0)const{ size_t p=v.find(c,from); return p==std::string::npos?-1:(int)p;}
  String substring(int a,int b)const{ if(a<0)a=0; if(b>(int)v.size())b=v.size(); if(b<a)return String(""); return String(v.substr(a,b-a));}
  unsigned length()const{return v.size();}
  char operator[](int i)const{ return (i<0||i>=(int)v.size())?0:v[i]; }
  float toFloat()const{return (float)atof(v.c_str());}
  int toInt()const{return atoi(v.c_str());}
  String& operator+=(const char*c){v+=c;return *this;} String& operator+=(const String&c){v+=c.v;return *this;} String& operator+=(char c){v+=c;return *this;}
};
static bool isDigit(char c){return c>='0'&&c<='9';}
#define DLOG(a,b,c) do{}while(0)
#define DLOGF(a,b,...) do{}while(0)
#define F(x) x
