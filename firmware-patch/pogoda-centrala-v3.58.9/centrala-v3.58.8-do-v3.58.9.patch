+// Ograniczony odbiornik danych do HTTPClient::writeToStream. PSRAM jest
+// wymagana przez istniejacy JsonDocument, wiec nie zajmujemy wewnetrznego RAM.
+class PrognozaOdbiornik : public Stream {
+ public:
+  explicit PrognozaOdbiornik(size_t maxBytes) : max_(maxBytes) {
+    buf_ = static_cast<uint8_t*>(heap_caps_malloc(maxBytes + 1, MALLOC_CAP_SPIRAM));
+    if (buf_) buf_[0] = 0;
+  }
+  ~PrognozaOdbiornik() override { if (buf_) heap_caps_free(buf_); }
+  PrognozaOdbiornik(const PrognozaOdbiornik&) = delete;
+  PrognozaOdbiornik& operator=(const PrognozaOdbiornik&) = delete;
+  size_t write(uint8_t b) override { return write(&b, 1); }
+  size_t write(const uint8_t* data, size_t n) override {
+    if (!buf_ || n > max_ - used_) { overflow_ = true; return 0; }
+    memcpy(buf_ + used_, data, n);
+    used_ += n; buf_[used_] = 0; return n;
+  }
+  int available() override { return 0; }
+  int read() override { return -1; }
+  int peek() override { return -1; }
+  void flush() override {}
+  bool gotowy() const { return buf_ != nullptr; }
+  bool przepelniony() const { return overflow_; }
+  size_t size() const { return used_; }
+  const char* data() const { return reinterpret_cast<const char*>(buf_); }
+ private:
+  uint8_t* buf_ = nullptr;
+  size_t max_, used_ = 0;
+  bool overflow_ = false;
+};
