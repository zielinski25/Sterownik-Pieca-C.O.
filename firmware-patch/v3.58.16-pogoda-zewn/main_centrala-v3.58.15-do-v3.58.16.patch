+// wartosc zostaje nietknieta (wolajacy wpisuje -1 wczesniej).
+static bool pogoda_json_liczba_w_bloku(const String &body, int od, int do_, const char *klucz, float &wynik) {
+  String k = "\""; k += klucz; k += "\":";
+  int p = body.indexOf(k, od);
+  if (p < 0 || p >= do_) return false;
+  p += k.length();
+  int e = p;
+  while (e < (int)body.length() && (isDigit(body[e]) || body[e] == '.' || body[e] == '-')) e++;
+  if (e == p) return false;   // np. null
+  wynik = body.substring(p, e).toFloat();
+  return true;
+}
 
