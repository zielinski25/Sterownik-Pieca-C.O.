+// Token CSRF dla jedynego nowego lokalnego endpointu mutujacego stan serw.
+// Powstaje raz przed wystawieniem tras, trafia tylko do HTML z ESP i jest
+// wymagany przez POST; obce strony nie moga go odczytac przez same-origin policy.
+static String g_wifiLocalActionToken;
+static void wifiLocalActionTokenEnsure() {
+  if (g_wifiLocalActionToken.length() != 0) return;
+  uint64_t token = 0;
+  do {
+    const uint64_t hi = (uint64_t)esp_random();
+    const uint64_t lo = (uint64_t)esp_random();
+    token = (hi << 32) | lo;
+  } while (token == 0);
+  char tokenHex[17];
+  snprintf(tokenHex, sizeof(tokenHex), "%016llx", (unsigned long long)token);
+  g_wifiLocalActionToken = tokenHex;
+}
