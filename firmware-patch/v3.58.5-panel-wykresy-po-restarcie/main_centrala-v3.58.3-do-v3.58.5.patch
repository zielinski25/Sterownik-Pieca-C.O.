+// [v3.58.4 PANEL-WYKRESY-BEGIN]
+// ============================================================================
+// [v3.58.4 PANEL-WYKRESY] Gotowe punkty wykresu dla panelu LCD
+// (GET /api/history/panel?tryb=godz|dzien|tydz&pkt=96).
+//
+// Po co: panel LCD nie ma internetu ani dysku - dane do wykresow bierze od
+// centrali. Do v3.58.3 pobieral CALY CSV historii (/api/history: do ok. 100 kB,
+// /api/history/long: do ok. 1,8 MB) i sam sciskal go do 96 punktow. Teraz
+// centrala robi to u siebie i wysyla najwyzej `pkt` wierszy (ok. 20 kB).
+//
+// Zrodlo danych: te same dwa bufory w PSRAM, z ktorych korzysta strona WWW
+// (historiaBufor - probka co 60 s, do 24 h; historiaDlugaBufor - do 8000
+// zdarzen). Oba sa przy starcie odtwarzane z plikow /hist_short.csv i
+// /hist_long.csv, a kazda nowa probka jest do tych plikow dopisywana - to sa
+// wiec dane "z pliku centrali", tylko czytane z pamieci, bez dotykania flasha
+// w handlerze HTTP. Firebase NIE jest tu uzywany.
+//
+// Zakresy:
+//   godz  - ostatnia godzina, bufor krotki
+//   dzien - ostatnie 24 h, bufor krotki
+//   tydz  - ostatnie 7 dni: bufor dlugi dla czasu sprzed bufora krotkiego,
+//           a dla ostatnich 24 h bufor krotki (dokladniejszy)
+// Koniec okna = czas najnowszej probki. [v3.58.5] Wyjatek: gdy wedlug zegara
+// centrali od najnowszej probki minelo wiecej niz prog przerwy (historia
+// konczy sie w przeszlosci - np. centrala wlasnie wstala i ma w buforach tylko
+// to, co wczytala z plikow), okno konczy sie na biezacym czasie.
+// [v3.58.5] Poczatek okna = pierwsza sekunda zakresu, z ktorej jest pomiar.
+// Gdy historii jest mniej niz zakres - takze wtedy, gdy w buforach leza jeszcze
+// stare probki sprzed zakresu - os czasu obejmuje tylko to, co jest.
+// (W 3.58.4 okno zaczynalo sie od najstarszej probki w buforach: stara probka
+// sprzed zakresu rozciagala os na caly zakres, a swieze pomiary po restarcie
+// centrali miescily sie w jednym punkcie - panel pisal "za malo danych".)
+//
+// Os czasu jest liniowa: okno dzielone jest na `pkt` rownych odcinkow. Wartosc
+// probki obowiazuje do nastepnej probki (bufor dlugi jest zdarzeniowy - brak
+// wpisu znaczy "bez zmian"), chyba ze odstep przekracza prog przerwy (te same
+// progi co PROG_DZIURY_KROTKI_S / PROG_DZIURY_DLUGI_S w JS strony WWW) - wtedy
+// odcinki bez danych wychodza jako linia "#przerwa".
+//
+// Odpowiedz (text/plain):
+//   #panel-hist 1 tryb=dzien pkt=96 wierszy=1440 od=<unix> do=<unix> krok_s=900 zrodlo=lokalne fs=1 od_etyk=12.11_13:01 do_etyk=13.11_13:00
+//       wierszy  - ile wierszy historii wzieto pod uwage (cale bufory, nie tylko okno)
+//       od, do   - poczatek i koniec okna (Unix UTC; 0 = centrala nie zna czasu). Koniec to czas
+//                  najnowszej probki albo - gdy historia konczy sie w przeszlosci - biezacy czas.
+//       od_etyk, do_etyk - to samo jako czas lokalny centrali: "HH:MM" w trybie godz,
+//                  "DD.MM_HH:MM" w trybach dzien i tydz, "--:--" bez zegara. Panel nie
+//                  ma strefy czasowej, a podpisuje tym os czasu.
+//       fs       - 1 = historia jest tez zapisywana do plikow na flashu centrali
+//   <wiersz w formacie /api/history/long: etykieta, 11 x (sr,min,max), czas_unix, pompa>
+//   #przerwa                    <- odcinek bez danych (centrala nie pracowala)
+//   ...
+//   #koniec <liczba wierszy i przerw powyzej>
+// Liczby maja jedno miejsce po przecinku; pole bez wartosci to "nan".
+//
+// Rachunki sa calkowitoliczbowe (dziesiate czesci jednostki x sekundy), wiec
+// wynik nie zalezy od zaokraglen float i jest taki sam w tescie na PC
+// (tests/ w paczce) i na ESP32.
+// Funkcja tylko CZYTA bufory historii - niczego w centrali nie zmienia.
+// ============================================================================
+#define PANEL_HIST_POLA             11
+#define PANEL_HIST_PKT_DOMYSLNIE    96
+#define PANEL_HIST_PKT_MIN          8
+#define PANEL_HIST_PKT_MAX          240
+#define PANEL_HIST_OKNO_GODZ_S      3600U
+#define PANEL_HIST_OKNO_DZIEN_S     86400U
+#define PANEL_HIST_OKNO_TYDZ_S      604800U
+#define PANEL_HIST_PRZERWA_KROTKI_S 360U     // = PROG_DZIURY_KROTKI_S w JS strony WWW
+#define PANEL_HIST_PRZERWA_DLUGI_S  5400U    // = PROG_DZIURY_DLUGI_S w JS strony WWW
+#define PANEL_HIST_ODSTEP_PROBEK_S  60U      // = HISTORIA_PROBKA_MS / 1000
+#define PANEL_HIST_BRAK             INT32_MIN  // pole bez wartosci (NaN, nieskonczonosc, wartosc absurdalna)
+#define PANEL_HIST_CZAS_MAX         4102444800U   // 2100-01-01 UTC; pozniejszy czas w probce to blad zegara
+#define PANEL_HIST_CZAS_PEWNY       1700000000U   // [v3.58.5] 2023-11-14 UTC; wczesniejszy czas probki albo zegara to nie jest prawdziwa data
+
+// Jeden wiersz zrodlowy we wspolnej postaci: wartosci w dziesiatych czesciach.
+struct PanelHistWiersz {
+  uint32_t czas;                  // Unix UTC; 0 = probka bez wiarygodnego czasu
+  int32_t  sr[PANEL_HIST_POLA];
+  int32_t  mn[PANEL_HIST_POLA];
+  int32_t  mx[PANEL_HIST_POLA];
+  int8_t   pompa;                 // 0/1, -1 = brak danych
+  bool     dlugi;                 // wiersz z bufora dlugiego (inny prog przerwy)
+};
+
+// Jeden punkt wyjsciowy (odcinek osi czasu).
+struct PanelHistKubelek {
+  int64_t  suma[PANEL_HIST_POLA];   // suma (wartosc x sekundy)
+  uint32_t waga[PANEL_HIST_POLA];   // sekundy z wazna wartoscia danego pola
+  int32_t  mn[PANEL_HIST_POLA];
+  int32_t  mx[PANEL_HIST_POLA];
+  uint32_t wagaRazem;               // sekundy pokryte jakimkolwiek wierszem; 0 = przerwa
+  int8_t   pompa;
+};
+
+// Skad brac wiersze - migawka licznikow obu buforow kolowych.
+struct PanelHistZrodlo {
+  int      startK, ileK;        // bufor krotki: indeks najstarszej probki i liczba probek
+  int      startD, ileD;        // bufor dlugi (ileD == 0, gdy tryb go nie uzywa)
+  uint32_t granicaD;            // z bufora dlugiego brane sa wiersze o czasie < granicaD (0 = wszystkie)
+  int      pierwszyZCzasemK;    // indeks (0..ileK-1) pierwszej probki krotkiej z czasem; -1 = zadna
+  uint32_t czasPierwszegoK;     // jej czas
+};
+
+static int32_t panelHistDziesiate(float v) {
+  if (!(v == v)) return PANEL_HIST_BRAK;                   // NaN
+  if (v > 9999.9f || v < -9999.9f) return PANEL_HIST_BRAK; // nieskonczonosc albo wartosc bez sensu
+  return (int32_t)lroundf(v * 10.0f);
+}
+
+static void panelHistZKrotkiej(const HistoriaProbka &p, PanelHistWiersz &w) {
+  const float v[PANEL_HIST_POLA] = {
+    p.t_zewn, p.t_bojler, p.t_ogrz, p.t_ogrz_sr, p.t_powrot, p.t_panel, p.t_pokoj,
+    p.cisnienie, p.wilgotnosc, (float)p.klapa_proc, (float)p.syberko_proc
+  };
+  w.czas = p.czas_unix;
+  w.pompa = p.pompa ? 1 : 0;
+  w.dlugi = false;
+  for (int i = 0; i < PANEL_HIST_POLA; i++) w.sr[i] = w.mn[i] = w.mx[i] = panelHistDziesiate(v[i]);
+}
+
+static void panelHistZDlugiej(const HistoriaProbkaDluga &p, PanelHistWiersz &w) {
+  const float sr[PANEL_HIST_POLA] = {
+    p.t_zewn_sr, p.t_bojler_sr, p.t_ogrz_sr, p.t_ogrz_sr_sr, p.t_powrot_sr, p.t_panel_sr, p.t_pokoj_sr,
+    p.cisnienie_sr, p.wilgotnosc_sr, (float)p.klapa_proc_sr, (float)p.syberko_proc_sr
+  };
+  const float mn[PANEL_HIST_POLA] = {
+    p.t_zewn_min, p.t_bojler_min, p.t_ogrz_min, p.t_ogrz_sr_min, p.t_powrot_min, p.t_panel_min, p.t_pokoj_min,
+    p.cisnienie_min, p.wilgotnosc_min, (float)p.klapa_proc_min, (float)p.syberko_proc_min
+  };
+  const float mx[PANEL_HIST_POLA] = {
+    p.t_zewn_max, p.t_bojler_max, p.t_ogrz_max, p.t_ogrz_sr_max, p.t_powrot_max, p.t_panel_max, p.t_pokoj_max,
+    p.cisnienie_max, p.wilgotnosc_max, (float)p.klapa_proc_max, (float)p.syberko_proc_max
+  };
+  w.czas = p.czas_unix;
+  w.pompa = (p.pompa == 0 || p.pompa == 1) ? p.pompa : (int8_t)-1;
+  w.dlugi = true;
+  for (int i = 0; i < PANEL_HIST_POLA; i++) {
+    w.sr[i] = panelHistDziesiate(sr[i]);
+    w.mn[i] = panelHistDziesiate(mn[i]);
+    w.mx[i] = panelHistDziesiate(mx[i]);
+    // Wiersz ze srednia, ale bez min/max (albo odwrotnie) traktujemy jak punkt.
+    if (w.sr[i] == PANEL_HIST_BRAK) { w.mn[i] = w.mx[i] = PANEL_HIST_BRAK; continue; }
+    if (w.mn[i] == PANEL_HIST_BRAK || w.mn[i] > w.sr[i]) w.mn[i] = w.sr[i];
+    if (w.mx[i] == PANEL_HIST_BRAK || w.mx[i] < w.sr[i]) w.mx[i] = w.sr[i];
+  }
+}
+
+// Czy wpis bufora dlugiego o czasie `czas` wchodzi do wykresu: musi miec czas
+// i lezec przed granica, od ktorej dane bierze sie z bufora krotkiego.
+static bool panelHistDlugiLiczySie(const PanelHistZrodlo &z, uint32_t czas) {
+  if (czas == 0 || czas > PANEL_HIST_CZAS_MAX) return false;
+  if (z.granicaD != 0 && czas >= z.granicaD) return false;
+  return true;
+}
+
+// Czas probki krotkiej nr `k` (0 = najstarsza), ktora w buforze ma czas `czas`.
+// Probka bez czasu dostaje czas wyliczony z sasiadow (probki sa co 60 s):
+// `poprzedniCzasK` to czas poprzedniej probki krotkiej (0 = jeszcze zadnej nie
+// bylo). Gdy zadna probka nie ma czasu, czasem jest numer probki.
+static uint32_t panelHistCzasKrotkiej(const PanelHistZrodlo &z, int k, uint32_t czas, uint32_t poprzedniCzasK) {
+  if (czas != 0 && czas <= PANEL_HIST_CZAS_MAX) return czas;
+  if (poprzedniCzasK != 0) return poprzedniCzasK + PANEL_HIST_ODSTEP_PROBEK_S;
+  if (z.pierwszyZCzasemK > k) {
+    const uint32_t wstecz = (uint32_t)(z.pierwszyZCzasemK - k) * PANEL_HIST_ODSTEP_PROBEK_S;
+    return (z.czasPierwszegoK > wstecz) ? (z.czasPierwszegoK - wstecz) : 1U;
+  }
+  return 1U + (uint32_t)k * PANEL_HIST_ODSTEP_PROBEK_S;   // brak zegara w calym buforze
+}
+
+// Wiersz nr `i` z ciagu "najpierw bufor dlugi, potem krotki" (kolejnosc
+// chronologiczna). Zwraca false, gdy wiersz ma byc pominiety.
+static bool panelHistWiersz(const PanelHistZrodlo &z, int i, uint32_t poprzedniCzasK, PanelHistWiersz &w) {
+  if (i < z.ileD) {
+    const int idx = (z.startD + i) % HISTORIA_DLUGA_MAX_PROBEK;
+    const HistoriaProbkaDluga p = historiaDlugaBufor[idx];   // kopia: bufor moze dostac nowy wpis w trakcie
+    if (!panelHistDlugiLiczySie(z, p.czas_unix)) return false;
+    panelHistZDlugiej(p, w);
+    return true;
+  }
+  const int k = i - z.ileD;
+  if (k >= z.ileK) return false;
+  const int idx = (z.startK + k) % HISTORIA_MAX_PROBEK;
+  const HistoriaProbka p = historiaBufor[idx];
+  panelHistZKrotkiej(p, w);
+  w.czas = panelHistCzasKrotkiej(z, k, w.czas, poprzedniCzasK);
+  return true;
+}
+
+// [v3.58.5] To samo co panelHistWiersz(), ale tylko CZAS wiersza i rodzaj
+// bufora - bez kopiowania wiersza i przeliczania jego 33 wartosci. Dla
+// przebiegow, ktore ustalaja okno czasu. Te same reguly (dwie funkcje wyzej),
+// wiec oba odczyty wybieraja te same wiersze i daja im ten sam czas.
+static bool panelHistCzasWiersza(const PanelHistZrodlo &z, int i, uint32_t poprzedniCzasK, uint32_t &czas, bool &dlugi) {
+  if (i < z.ileD) {
+    const uint32_t c = historiaDlugaBufor[(z.startD + i) % HISTORIA_DLUGA_MAX_PROBEK].czas_unix;
+    if (!panelHistDlugiLiczySie(z, c)) return false;
+    czas = c;
+    dlugi = true;
+    return true;
+  }
+  const int k = i - z.ileD;
+  if (k >= z.ileK) return false;
+  czas = panelHistCzasKrotkiej(z, k, historiaBufor[(z.startK + k) % HISTORIA_MAX_PROBEK].czas_unix, poprzedniCzasK);
+  dlugi = false;
+  return true;
+}
+
