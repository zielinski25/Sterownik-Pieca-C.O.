+    int a[5], b[5];
+    for (int i = 0; i < 5; i++) a[i] = *pola[i];
+    for (int i = 0; i < 5; i++) b[i] = *pola[i];
+    if (memcmp(a, b, sizeof(a)) != 0) continue;
+    if (a[0] < 2024 || a[0] > 2099 || a[1] < 1 || a[1] > 12 || a[2] < 1 || a[2] > 31 ||
