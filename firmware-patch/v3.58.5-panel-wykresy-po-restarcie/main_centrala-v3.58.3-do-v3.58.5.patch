+static uint32_t panelHistDoKiedy(uint32_t czasA, bool dlugiA, uint32_t czasB, bool dlugiB) {
+  const uint32_t prog = (dlugiA || dlugiB) ? PANEL_HIST_PRZERWA_DLUGI_S : PANEL_HIST_PRZERWA_KROTKI_S;
