+// Dopisuje do `buf` liczbe w dziesiatych jako "X.Y" i przecinek. Zwraca nowa dlugosc.
+static size_t panelHistLiczba(char *buf, size_t rozmiar, size_t dl, int32_t dziesiate) {
+  if (dl >= rozmiar) return rozmiar;
+  int n;
+  if (dziesiate == PANEL_HIST_BRAK) {
+    n = snprintf(buf + dl, rozmiar - dl, "nan,");
+  } else {
+    const long v = (long)dziesiate;
+    const long bezwzgl = (v < 0) ? -v : v;
+    n = snprintf(buf + dl, rozmiar - dl, "%s%ld.%ld,", (v < 0) ? "-" : "", bezwzgl / 10, bezwzgl % 10);
+  }
+  if (n < 0 || (size_t)n >= rozmiar - dl) return rozmiar;
+  return dl + (size_t)n;
+}
+
+// Czas `czas` (Unix UTC) jako czas lokalny centrali: "HH:MM" albo, z data,
+// "DD.MM<odstep>HH:MM". Zwraca liczbe wpisanych znakow.
+static size_t panelHistEtykieta(char *buf, size_t rozmiar, uint32_t czas, bool zData, char odstep) {
+  const time_t t = (time_t)czas;
+  struct tm lok;
+  memset(&lok, 0, sizeof(lok));
+  localtime_r(&t, &lok);
+  int n;
+  if (zData) n = snprintf(buf, rozmiar, "%02d.%02d%c%02d:%02d", lok.tm_mday, lok.tm_mon + 1, odstep, lok.tm_hour, lok.tm_min);
+  else       n = snprintf(buf, rozmiar, "%02d:%02d", lok.tm_hour, lok.tm_min);
+  if (n < 0 || (size_t)n >= rozmiar) { if (rozmiar > 0) buf[0] = '\0'; return 0; }
+  return (size_t)n;
+}
