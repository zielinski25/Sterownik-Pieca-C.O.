+// Filtr po zegarze przegladarki, a nie po liczbie punktow: dluga historia
+// jest zdarzeniowa. Nie zgadujemy daty dla probek bez prawidlowego czasu.
+function wykrIndeksyOkresu(czasy, odS, doS){
+  var out = [];
+  czasy.forEach(function(t, i){ if (Number.isFinite(t) && t > 0 && t >= odS && t <= doS) out.push(i); });
+  return out;
+}
+function wykrStatPompy(stany, czasy, prog){
+  var on=0, off=0, zmiany=0, prev=NaN;
+  stany.forEach(function(v, i){
+    if (i > 0 && (!Number.isFinite(czasy[i]) || !Number.isFinite(czasy[i-1]) || czasy[i] - czasy[i-1] > prog || czasy[i] < czasy[i-1])) prev=NaN;
+    if (v !== 0 && v !== 1) { prev=NaN; return; }
+    if (v === 1) on++; else off++;
+    if (Number.isFinite(prev) && prev !== v) zmiany++;
+    prev=v;
+  });
+  return {on:on, off:off, zmiany:zmiany};
+}
