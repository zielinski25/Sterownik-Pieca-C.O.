+// [v3.55.2 TASK-SUPERVISOR] Nadzor zadan sieciowych — patrz changelog na gorze.
+//
+// Wykrywa przypadek, w ktorym Telegram/Firebase zamilkly na dobre: wtedy nie ma
+// juz ZADNEJ zdalnej drogi powrotu, wiec jedynym wyjsciem jest restart.
+//
+// Podzial na dwie czesci jest celowy:
+//   * nadzorDecyzja()  — czysta funkcja, zero I/O, zero config, zero millis.
+//     Dzieki temu ta sama logika jest sprawdzana testem hostowym
+//     (tests/host/NadzorHostTest.cpp) na zwyklym komputerze, bez plytki.
+//   * nadzorZadanSieciowych() — cienka otoczka: czyta licznik z NVS, pisze log
+//     i restartuje. Nic wiecej.
+static const uint32_t NADZOR_PROG_MS           = 300000UL;  // 5 min milczenia
+static const uint32_t NADZOR_ROZBIEG_MS        = 180000UL;  // 3 min po starcie
+static const uint32_t NADZOR_LICZNIK_WAZNY_MS  = 1800000UL; // 30 min = sukces
+static const uint8_t  NADZOR_MAX_RESTARTOW     = 3U;
+
+enum NadzorDecyzja : uint8_t {
+  NADZOR_BRAK    = 0,   // wszystko zyje — nic nie robimy
+  NADZOR_RESTART = 1,   // zadanie milczy za dlugo — restartuj
+  NADZOR_LIMIT   = 2,   // przekroczony limit restartow — tylko loguj
+  NADZOR_USPIONY = 3    // rozbieg / OTA / testy / zadania jeszcze nie ruszajace
+};
+
+// kto: 0 = nikt, 1 = tgTask, 2 = tgPollTask
+struct NadzorWejscie {
+  uint32_t nowMs;
+  uint32_t hbTg;
+  uint32_t hbPoll;
+  uint32_t licznikRestartow;
+  bool     blokada;      // OTA / test regresyjny w trakcie
+};
+
+static NadzorDecyzja nadzorDecyzja(const NadzorWejscie &w, uint8_t *kto, uint32_t *wiekMs) {
+  if (kto)     *kto = 0;
+  if (wiekMs)  *wiekMs = 0U;
+
+  if (w.nowMs < NADZOR_ROZBIEG_MS) return NADZOR_USPIONY;   // dopiero wstalismy
+  if (w.blokada)                   return NADZOR_USPIONY;   // OTA / testy
+  if (w.hbTg == 0U && w.hbPoll == 0U) return NADZOR_USPIONY; // zadania jeszcze nie wystartowaly
+
+  const uint32_t wiekTg   = (w.hbTg   == 0U) ? 0U : (uint32_t)(w.nowMs - w.hbTg);
+  const uint32_t wiekPoll = (w.hbPoll == 0U) ? 0U : (uint32_t)(w.nowMs - w.hbPoll);
+
+  uint8_t  k = 0U;
+  uint32_t wiek = 0U;
+  if (wiekTg >= NADZOR_PROG_MS)        { k = 1U; wiek = wiekTg; }
+  else if (wiekPoll >= NADZOR_PROG_MS) { k = 2U; wiek = wiekPoll; }
+  if (k == 0U) return NADZOR_BRAK;
+  if (kto)    *kto = k;
+  if (wiekMs) *wiekMs = wiek;
+
+  return (w.licznikRestartow >= NADZOR_MAX_RESTARTOW) ? NADZOR_LIMIT : NADZOR_RESTART;
+}
+
+static const char *nadzorKtoNazwa(uint8_t kto) {
+  switch (kto) {
+    case 1U: return "tgTask (Telegram i Firebase)";
+    case 2U: return "tgPollTask (odbieranie komend)";
+    default: return "?";
+  }
+}
+
+static void nadzorZadanSieciowych() {
+  // Sprawdzamy raz na sekunde — prog to 5 minut, wiec czesciej nie ma sensu.
+  // Dzieki temu nadzor nie doklada zadnego kosztu do kazdej iteracji loop().
+  static uint32_t ostatnieSprawdzenieMs = 0U;
+  const uint32_t now = millis();
+  if (ostatnieSprawdzenieMs != 0U && (uint32_t)(now - ostatnieSprawdzenieMs) < 1000UL) return;
+  ostatnieSprawdzenieMs = now;
+
+  // Licznik restartow czytamy z NVS RAZ na start, potem trzymamy w pamieci —
+  // odczyt NVS w kazdej iteracji petli glownej bylby zbednym kosztem.
+  static uint32_t licznikRestartow = 0U;
+  static bool     licznikWczytany  = false;
+  static bool     licznikWyczyszczony = false;
+  if (!licznikWczytany) {
+    licznikWczytany = true;
+    licznikRestartow = (uint32_t)config.getUInt("nadzorCnt", 0U);
+  }
+
+  // Po 30 min nieprzerwanej pracy licznik restartow jest juz nieaktualny —
+  // zerujemy go RAZ, ale nadzoru NIE wylaczamy.
+  if (!licznikWyczyszczony && now >= NADZOR_LICZNIK_WAZNY_MS) {
+    licznikWyczyszczony = true;
+    licznikRestartow = 0U;
+    if (config.getUInt("nadzorCnt", 0U) != 0U) config.putUInt("nadzorCnt", 0U);
+  }
+
+  const bool blokada = (otaOperacjaWTrakcie || otaUploadTrwa ||
+                        g_stabilityMegaActive || g_finalMegaActive ||
+                        g_recoveryOtaMegaActive || g_spoolGTestActive);
+
+  NadzorWejscie wejscie;
+  wejscie.nowMs            = now;
+  wejscie.hbTg             = __atomic_load_n(&g_tgTaskHeartbeatMs, __ATOMIC_ACQUIRE);
+  wejscie.hbPoll           = __atomic_load_n(&g_tgPollHeartbeatMs, __ATOMIC_ACQUIRE);
+  wejscie.licznikRestartow = licznikRestartow;
+  wejscie.blokada          = blokada;
+
+  uint8_t  kto  = 0U;
+  uint32_t wiek = 0U;
+  const NadzorDecyzja decyzja = nadzorDecyzja(wejscie, &kto, &wiek);
+
+  if (decyzja == NADZOR_BRAK || decyzja == NADZOR_USPIONY) return;
+
+  if (decyzja == NADZOR_LIMIT) {
+    // Trzecia proba z rzedu nie pomogla — nie robimy petli restartow.
+    // Log najwyzej raz na 10 min, zeby nie zawalic pamieci flash.
+    static uint32_t ostatniLogMs = 0U;
+    if (ostatniLogMs == 0U || (uint32_t)(now - ostatniLogMs) > 600000UL) {
+      ostatniLogMs = now;
+      zapiszLog(String(F("tag=NADZOR lvl=ERR zdarzenie=limit_restartow kto=")) +
+                nadzorKtoNazwa(kto) + " wiek_ms=" + String((unsigned long)wiek) +
+                " msg=\"poddalem sie - wymagana interwencja\"");
+    }
+    return;
+  }
+
+  // NADZOR_RESTART
+  licznikRestartow += 1U;
+  zapiszLog(String(F("tag=NADZOR lvl=ERR zdarzenie=zawieszenie kto=")) +
+            nadzorKtoNazwa(kto) + " wiek_ms=" + String((unsigned long)wiek) +
+            " restart_nr=" + String((unsigned long)licznikRestartow));
+  config.putUInt("nadzorCnt", licznikRestartow);
+  config.putBool("nadzorRestart", true);
+  config.putString("nadzorKto", nadzorKtoNazwa(kto));
+  config.putUInt("nadzorMs", wiek);
+  delay(50);
+  ESP.restart();
+}
