+// [v3.55.2] Lekki slad pojedynczego kroku wifiLoop().
+// Zapisuje TYLKO numer kroku (op/stage/detail/uptime) — bez pomiaru sterty.
+// Powod: wifiLoop() jest wolane w kazdej iteracji loop(), wiec te zapisy musza
+// byc tanie. Numer kroku wystarcza, zeby po resecie odczytac z raportu
+// "LOOP op=WIFI_LOOP detail=3" i wiedziec, na ktorym wywolaniu stanelo.
+// Seq nie jest podbijany — dzieki temu nie zmienia sie rytm probkowania sterty
+// w zwyklych punktach kontrolnych.
+static inline void diagSladWifiLoop(uint16_t krok) {
+  CrashDiagTaskState &snap = rtcCrashDiag.task[DIAG_TASK_LOOP - 1U];
+  snap.op       = DIAG_OP_WIFI_LOOP;
+  snap.stage    = DIAG_STAGE_START;
+  snap.detail   = krok;
+  snap.uptimeMs = millis();
+}
