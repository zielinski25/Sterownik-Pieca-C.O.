+// [v3.58.7 START-TG-BEGIN]
+// Wiadomosc startowa na Telegram i rodzaj niezgodnosci TAGCHECK - czyste
+// funkcje (bez String, Arduino, NVS), zeby dalo sie je sprawdzic na PC
+// (tests/test_start_telegram.cpp). Kod klejacy (NVS, Telegram, stan OTA)
+// jest nizej, w wyslijWiadomoscStartowa() i potwierdzPartycjeJesliCzeka().
+enum StartTgDecyzja : uint8_t {
+  START_TG_WYSLIJ = 0,       // zwykly start bez innego raportu: SW, EXT, UNKNOWN, DEEPSLEEP, SDIO
+  START_TG_POWERON_OSOBNO,   // POWERON ma wlasne powiadomienie (powerOnNotice, z wersja)
+  START_TG_CRASH_OSOBNO,     // PANIC/WDT/BROWNOUT: raport crashu (z wersja i boot)
+  START_TG_NADZOR_OSOBNO,    // restart z nadzoru zadan: wyslijRaportNadzoru()
+};
+static StartTgDecyzja startTgDecyzja(esp_reset_reason_t powod, bool crash, bool restartZNadzoru) {
+  if (powod == ESP_RST_POWERON) return START_TG_POWERON_OSOBNO;
+  if (crash) return START_TG_CRASH_OSOBNO;
+  if (restartZNadzoru) return START_TG_NADZOR_OSOBNO;
+  return START_TG_WYSLIJ;
+}
+// Opis powodu po polsku (kod ESP w nawiasie, zeby dalo sie go znalezc w logu).
+static const char* startTgPowodOpis(esp_reset_reason_t powod) {
+  switch (powod) {
+    case ESP_RST_SW:        return "programowy (SW)";
+    case ESP_RST_EXT:       return "przycisk RESET / pin EN (EXT)";
+    case ESP_RST_DEEPSLEEP: return "wybudzenie z uspienia (DEEPSLEEP)";
+    case ESP_RST_SDIO:      return "SDIO";
+    case ESP_RST_POWERON:   return "wlaczenie zasilania (POWERON)";
+    default:                return "nieznany (UNKNOWN)";
+  }
+}
+// Ile minut stabilnej pracy potwierdza nowy program - ta sama liczba co
+// OTA_CONFIRM_UPTIME_MS (10 min; static_assert przy jego definicji pilnuje
+// zgodnosci, bo tamto #define jest dalej w pliku).
+#define START_TG_POTW_MIN 10U
+// Tresc wiadomosci startowej. Zwraca liczbe znakow, ktore snprintf() chcial
+// zapisac (jak snprintf) - test pilnuje, ze miesci sie w buforze.
+//   poOta/otaTag - w NVS jest otaSelfTrwa=true z tagiem (restart po /update)
+static int startTgTresc(char* buf, size_t n, const char* wersja, uint32_t boot, esp_reset_reason_t powod,
+                        bool poOta, const char* otaTag) {
+  const bool tagJest = poOta && otaTag != nullptr && otaTag[0] != '\0';
+  return snprintf(buf, n, "Centrala wystartowala: %s (boot=%lu). Powod restartu: %s%s%s%s%s.",
+                  wersja, (unsigned long)boot, startTgPowodOpis(powod),
+                  poOta ? " - po aktualizacji OTA" : "",
+                  tagJest ? " (tag " : "", tagJest ? otaTag : "", tagJest ? ")" : "");
+}
+// Dopisek o potwierdzeniu nowego programu (partycja PENDING_VERIFY) - osobno,
+// zeby tresc glowna byla krotka i stala (latwiej czytac w powiadomieniu).
+static int startTgDopisek(char* buf, size_t n, bool czekaNaPotw, unsigned potwMin) {
+  if (!czekaNaPotw) { if (n) buf[0] = '\0'; return 0; }
+  return snprintf(buf, n, " Nowy program czeka na potwierdzenie: %u min stabilnej pracy z WiFi; "
+                          "potem przyjdzie \"Aktualizacja zakonczona pomyslnie\" albo ostrzezenie.", potwMin);
+}
+
+enum TagcheckRodzaj : uint8_t {
+  TAGCHECK_ZGODNA = 0,        // dziala dokladnie to, co mialo byc
+  TAGCHECK_BINARKA_STARSZA,   // Release X, dziala < X: nie podbito FIRMWARE_VERSION przed kompilacja
+  TAGCHECK_BINARKA_NOWSZA,    // Release X, dziala > X: Release ma za maly numer (19.11: tag 3.58.5, dziala 3.58.6)
+};
+// porownanie = porownajWersje(FIRMWARE_VERSION, tagZRelease): <0, 0, >0.
+static TagcheckRodzaj tagcheckRodzaj(int porownanie) {
+  if (porownanie == 0) return TAGCHECK_ZGODNA;
+  return porownanie < 0 ? TAGCHECK_BINARKA_STARSZA : TAGCHECK_BINARKA_NOWSZA;
+}
+static int tagcheckTresc(char* buf, size_t n, TagcheckRodzaj rodzaj, const char* tag, const char* dziala) {
+  switch (rodzaj) {
+    case TAGCHECK_BINARKA_STARSZA:
+      return snprintf(buf, n,
+        "UWAGA: aktualizacja \"powiodla sie\" (flash + restart bez bledu), ale dziala wersja %s, "
+        "a mial byc zainstalowany %s. Binarka w Release %s jest STARSZA niz jego tag: zostala skompilowana "
+        "PRZED podniesieniem FIRMWARE_VERSION w kodzie. Popraw kod (FIRMWARE_VERSION = v%s), skompiluj od nowa "
+        "i podmien firmware.bin w Release %s. Do tego czasu /update bedzie w kolko probowal to samo.",
+        dziala, tag, tag, tag, tag);
+    case TAGCHECK_BINARKA_NOWSZA:
+      return snprintf(buf, n,
+        "Aktualizacja wgrana i dziala wersja %s - NOWSZA niz tag Release (%s), z ktorego ja pobrano. "
+        "Kod jest dobry; za maly numer ma Release na GitHub (binarka %s opublikowana pod tagiem %s). "
+        "Popraw tag i nazwe Release na numer dzialajacej wersji (%s, bez \"v\" - jak dotychczasowe tagi; ten sam firmware.bin). Petli nie bedzie: /update odmowi "
+        "(tag starszy niz dzialajaca wersja), ale do poprawki nie zobaczy tez zadnej nowszej wersji.",
+        dziala, tag, dziala, tag, dziala);
+    default:
+      return snprintf(buf, n, "Aktualizacja zakonczona pomyslnie. Dziala wersja: %s", dziala);
+  }
+}
+// [v3.58.7 START-TG-END]
+
+// [v3.58.7 START-TG] Kod klejacy wiadomosci startowej. Decyzja zapada raz
+// (g_startTgRozstrzygnieta); nieudana wysylka = ponowienie co 60 s, jak
+// powerOnNotice. g_startTgNadzor ustawia wyslijRaportNadzoru() (wolana
+// bezposrednio przed ta funkcja w tgTaskFn), gdy w NVS byl znacznik restartu
+// z nadzoru - wtedy raport nadzoru jest JEDYNA wiadomoscia o tym starcie.
+static bool g_startTgNadzor = false;
+static bool g_startTgRozstrzygnieta = false;
+static bool g_startTgDoWyslania = false;
+static unsigned long g_startTgOstatniaProbaMs = 0;
+static bool g_startTgProbaByla = false;
+
+static void wyslijWiadomoscStartowa() {
+  if (!tgEnabled) return;
+  const esp_reset_reason_t powod = esp_reset_reason();
+  if (!g_startTgRozstrzygnieta) {
+    g_startTgRozstrzygnieta = true;
+    const StartTgDecyzja d = startTgDecyzja(powod, bylCrash(powod), g_startTgNadzor);
+    g_startTgDoWyslania = (d == START_TG_WYSLIJ);
+    zapiszLog(String(F("tag=START-TG lvl=INFO zdarzenie=decyzja powod=")) + resetReasonNaTekst(powod) +
+              " boot=" + String((unsigned long)logBootCounter) +
+              " wynik=" + (d == START_TG_WYSLIJ ? "wyslij" : d == START_TG_POWERON_OSOBNO ? "poweron_osobno" :
+                           d == START_TG_CRASH_OSOBNO ? "crash_osobno" : "nadzor_osobno"));
+  }
+  if (!g_startTgDoWyslania) return;
+
+  const unsigned long teraz = millis();
+  if (g_startTgProbaByla && (teraz - g_startTgOstatniaProbaMs) < 60000UL) return;
+  g_startTgProbaByla = true;
+  g_startTgOstatniaProbaMs = teraz;
+
+  // Czy to restart po wlasnym /update (znacznik zapisany przed flashowaniem w
+  // case TG_UPDATE; TYLKO odczyt - sprzata go potwierdzPartycjeJesliCzeka()).
+  const bool poOta = config.getBool("otaSelfTrwa", false);
+  const String otaTag = poOta ? config.getString("otaSelfTag", "") : String("");
+  esp_ota_img_states_t stanOta = ESP_OTA_IMG_UNDEFINED;
+  const bool czekaNaPotw = esp_ota_get_state_partition(esp_ota_get_running_partition(), &stanOta) == ESP_OK &&
+                           stanOta == ESP_OTA_IMG_PENDING_VERIFY;
+
+  // Bufory na stercie, nie na stosie zadania Telegrama (hwm_tg ok. 2,2 kB -
+  // ten sam powod co calloc() w kodzie klejacym OTA panelu).
+  const size_t N_TRESC = 200, N_DOPISEK = 200;
+  char *tresc = (char *)calloc(1, N_TRESC + N_DOPISEK);
+  if (tresc == nullptr) {
+    zapiszLog(F("tag=START-TG lvl=WARN zdarzenie=brak_pamieci retry_za_ge_60s"));
+    return;
+  }
+  char *dopisek = tresc + N_TRESC;
+  startTgTresc(tresc, N_TRESC, FIRMWARE_VERSION, logBootCounter, powod, poOta, otaTag.c_str());
+  startTgDopisek(dopisek, N_DOPISEK, czekaNaPotw, START_TG_POTW_MIN);
+  const bool wyslano = sendTelegramMessage(String(tresc) + dopisek);
+  free(tresc);
+  if (!wyslano) {
+    zapiszLog(String(F("tag=START-TG lvl=WARN zdarzenie=odroczona boot=")) + String((unsigned long)logBootCounter) +
+              " retry_za_ge_60s");
+    return;
+  }
+  g_startTgDoWyslania = false;
+  zapiszLog(String(F("tag=START-TG lvl=INFO zdarzenie=wyslana boot=")) + String((unsigned long)logBootCounter) +
+            " powod=" + resetReasonNaTekst(powod) + " po_ota=" + (poOta ? "1" : "0") +
+            " czeka_na_potwierdzenie=" + (czekaNaPotw ? "1" : "0"));
+}
