+  // wspolnej blokady dwa zadania wchodza do VFS naraz (ESP32 nie ma tego
+  // zagwarantowanego samo z siebie, patrz [v3.55.9 HISTORIA-PIN]). Ten sam
+  // logMutex, ktory bierze historiaFlushDoFS() i historiaPrzytnijPlik().
+  if (!logMutex || xSemaphoreTake(logMutex, pdMS_TO_TICKS(500)) != pdTRUE) {
+    DLOG(DC_HISTORIA, DL_WARN, F("HIST-FS zdarzenie=czysc_odrzucony msg=\"zapis do LittleFS zajety, sprobuj ponownie\""));
+    return false;
+  }
+  const bool ok = historiaFsCzyscZadajBezBlokady();
+  xSemaphoreGive(logMutex);
+  return ok;
