 // [v3.57.4 HIST-FS-OPT / v3.57.5] Odtworzenie przelacznika z NVS na starcie.
 // Wolane w setup() przed historiaWczytajZFS()/historiaDlugaWczytajZFS().
 // Czyszczenia tu nie ma - robi je kanal A1 wewnatrz historiaBoot.start(),
 // czyli WCZESNIEJ niz to wywolanie (patrz komentarz wyzej).
 // Serial.printf, nie DLOG: diagInit() jest dopiero nizej w setup().
+// [v3.57.6 HIST-FS-REPAIR] Wolane z setup() po udanym mountcie, PRZED
+// historiaBoot.start(). Surowy LittleFS (nie systemFS196): nakladka jest
+// w fazie Checking i nie wydaje jeszcze uchwytow.
+static void historiaFsNaprawUszkodzoneZadanie() {
+  if (!littlefsReady) return;
+  if (!LittleFS.exists("/history_reset_a1.req")) return;
+  static const char ZADANIE[] = "RESET-HISTORY-A1\n";
+  const size_t dlugosc = sizeof(ZADANIE) - 1;
+  bool poprawny = false;
+  File r = LittleFS.open("/history_reset_a1.req", "r");
+  if (r) {
+    char odczyt[24] = {0};
+    const int n = static_cast<int>(r.readBytes(odczyt, sizeof(odczyt)));
+    poprawny = (n == static_cast<int>(dlugosc)) && (memcmp(odczyt, ZADANIE, dlugosc) == 0);
+    r.close();
+  }
+  if (poprawny) return;
+  if (LittleFS.exists("/history_reset_a1.req.bad")) LittleFS.remove("/history_reset_a1.req.bad");
+  bool ok = LittleFS.rename("/history_reset_a1.req", "/history_reset_a1.req.bad");
+  if (!ok) ok = LittleFS.remove("/history_reset_a1.req");
+  Serial.printf("tag=HIST-FS lvl=WARN zdarzenie=zadanie_a1_uszkodzone odlozone=%d msg=\"uszkodzone zadanie czyszczenia odlozone; historia startuje normalnie, pliki CSV nietkniete\"\n",
+                ok ? 1 : 0);
+}
