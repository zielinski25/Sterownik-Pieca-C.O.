+class HistoriaStrumien {
+public:
+  ~HistoriaStrumien() { zamknij(); }
+
+  // limitBajtow = 0 -> czytaj od poczatku. limitCzasuMs = 0 -> bez limitu.
+  bool otworz(File &f, uint32_t limitBajtow, uint32_t limitCzasuMs) {
+    zamknij();
+    if (!f) return false;
+    const uint32_t rozmiar = (uint32_t)f.size();
+    uint32_t pomin = 0U;
+    if (limitBajtow > 0U && rozmiar > limitBajtow) pomin = rozmiar - limitBajtow;
+    if (pomin > 0U) {
+      if (!f.seek(pomin)) return false;
+      _pierwszaNiepelna = true;   // trafilismy w srodek wiersza — odrzucimy go
+    }
+    _buf = (uint8_t *)ps_malloc(HISTORIA_STRUMIEN_PORCJA_BAJTOW);
+    if (!_buf) _buf = (uint8_t *)malloc(HISTORIA_STRUMIEN_PORCJA_BAJTOW);
+    if (!_buf) return false;
+    _f = f;
+    _rozmiar = rozmiar;
+    _pominBajtow = pomin;
+    _bufLen = 0U; _bufPos = 0U;
+    _eof = false; _przerwano = false;
+    _startMs = millis(); _limitMs = limitCzasuMs;
+    _linie = 0U; _bajty = 0U;
+    return true;
+  }
+
+  // Zwraca kolejna linie (bez '\n' i bez '\r'). false = koniec danych.
+  bool nastepna(String &out) {
+    out = "";
+    if (!_buf) return false;
+    for (;;) {
+      if (_bufPos >= _bufLen) {
+        if (_eof) {
+          if (out.length() == 0U) return false;
+          _pierwszaNiepelna = false;
+          ++_linie;                    // ostatni wiersz bez znaku konca
+          return true;
+        }
+        // Limit czasu sprawdzamy na granicy porcji — rzadko, a wystarczajaco.
+        if (_limitMs > 0U && (uint32_t)(millis() - _startMs) > _limitMs) {
+          _przerwano = true;
+          return false;
+        }
+        if (!doladuj()) return false;
+        continue;
+      }
+      const char c = (char)_buf[_bufPos++];
+      if (c == '\r') continue;         // CRLF -> traktujemy jak LF
+      if (c == '\n') {
+        if (_pierwszaNiepelna) {       // niedokonczony pierwszy wiersz
+          _pierwszaNiepelna = false;
+          out = "";
+          continue;
+        }
+        ++_linie;
+        return true;
+      }
+      if (out.length() < HISTORIA_STRUMIEN_LINIA_MAX_BAJTOW) out += c;
+      else {                           // wiersz absurdalnie dlugi — obetnij
+        while (_bufPos < _bufLen && _buf[_bufPos] != '\n') _bufPos++;
+      }
+    }
+  }
+
+  void zamknij() {
+    if (_buf) { free(_buf); _buf = nullptr; }
+    if (_f) _f.close();
+    _bufLen = 0U; _bufPos = 0U;
+    _eof = false;
+  }
+
+  uint32_t linie()     const { return _linie; }
+  uint32_t bajty()     const { return _bajty; }
+  bool     przerwano() const { return _przerwano; }
+  uint32_t czasMs()    const { return (uint32_t)(millis() - _startMs); }
+  uint32_t rozmiar()   const { return _rozmiar; }
+  uint32_t pominBajtow() const { return _pominBajtow; }
+
+private:
+  bool doladuj() {
+    if (!_f) { _eof = true; return true; }
+    _bufLen = (size_t)_f.read(_buf, HISTORIA_STRUMIEN_PORCJA_BAJTOW);
+    _bufPos = 0U;
+    if (_bufLen == 0U) { _eof = true; return true; }
+    _bajty += (uint32_t)_bufLen;
+    // Oddajemy czas schedulerowi (IDLE1 karmi Task WDT) po KAZDEJ porcji.
+    serwisujTWDTJesliZarejestrowany();
+    vTaskDelay(1);
+    return true;
+  }
+
+  File     _f;
+  uint8_t *_buf = nullptr;
+  size_t   _bufLen = 0U, _bufPos = 0U;
+  bool     _eof = false, _pierwszaNiepelna = false, _przerwano = false;
+  uint32_t _startMs = 0U, _limitMs = 0U, _linie = 0U, _bajty = 0U;
+  uint32_t _rozmiar = 0U, _pominBajtow = 0U;
+};
