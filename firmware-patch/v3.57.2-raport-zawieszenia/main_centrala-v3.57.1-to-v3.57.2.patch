+// [v3.57.2] Ostatni znacznik kontrolny zawieszonego zadania — czytany z pamieci
+// RTC (rtcCrashDiag), ktora diagCheckpoint() wypelnia przy kazdym kroku zadania.
+// Czysty odczyt: zero I/O, zero millis, zero zapisow.
+//
+// seq == 0 znaczy "to zadanie nie zapisalo ANI JEDNEGO znacznika od startu" —
+// czyli zawiesilo sie przed pierwsza iteracja. To tez jest odpowiedz, wiec
+// zwracamy znany=false zamiast pokazywac przypadkowe (zerowe) pola.
+struct NadzorKrok {
+  bool     znany;
+  uint16_t op;
+  uint8_t  stage;
+  uint32_t uptimeMs;
+  uint32_t freeHeap;
+};
+
+static NadzorKrok nadzorOdczytajKrok(uint8_t kto) {
+  NadzorKrok k = {false, 0U, 0U, 0U, 0U};
+  if (kto != 1U && kto != 2U) return k;
+  const uint8_t taskId = (kto == 1U) ? (uint8_t)DIAG_TASK_TG : (uint8_t)DIAG_TASK_TGPOLL;
+  const CrashDiagTaskState &snap = rtcCrashDiag.task[taskId - 1U];
+  if (snap.seq == 0U) return k;
+  k.znany    = true;
+  k.op       = snap.op;
+  k.stage    = snap.stage;
+  k.uptimeMs = snap.uptimeMs;
+  k.freeHeap = snap.freeHeap;
+  return k;
+}
