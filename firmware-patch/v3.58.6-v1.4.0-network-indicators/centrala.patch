+// Dwa publiczne DNS, jeden nieblokujacy UDP, odswiezanie co 15 s.
+// Publikacja pod spinlockiem: /api/status moze byc obslugiwane na innym rdzeniu.
+static portMUX_TYPE wanProbeMux = portMUX_INITIALIZER_UNLOCKED;
+static int wanProbeWynik = -1;
+static uint32_t wanProbeCzas = 0;
+static void wanProbePublikuj(int stan, uint32_t czas) {
+  portENTER_CRITICAL(&wanProbeMux);
+  wanProbeWynik = stan; wanProbeCzas = czas;
+  portEXIT_CRITICAL(&wanProbeMux);
+}
+static InternetProbe::Udp wanProbeUdp;
+static InternetProbe::Monitor<InternetProbe::Udp, void (*)(int, uint32_t)>
+  wanProbe(wanProbeUdp, wanProbePublikuj);
+static void wanProbeTick() {
+  static uint32_t lastTick = 0;
+  const uint32_t now = millis();
+  if (uint32_t(now - lastTick) < 100) return;
+  lastTick = now;
+  const bool connected = WiFi.status() == WL_CONNECTED;
+  uint32_t ip = 0;
+  if (connected) {
+    IPAddress a = WiFi.localIP();
+    ip = htonl((uint32_t(a[0]) << 24) | (uint32_t(a[1]) << 16) |
+               (uint32_t(a[2]) << 8) | uint32_t(a[3]));
+  }
+  wanProbe.tick(now, connected, ip, uint16_t(esp_random()));
+}
+static int wanProbeOdczytaj() {
+  // Brak STA to pewny brak lacznosci z Internetem centrali, niezaleznie od
+  // starego wyniku. Przy starcie/po bledzie lokalnym/wygasnieciu zwroc null.
+  if (WiFi.status() != WL_CONNECTED) return 0;
+  const uint32_t now = millis();
+  int stan; uint32_t czas;
+  portENTER_CRITICAL(&wanProbeMux);
+  stan = wanProbeWynik; czas = wanProbeCzas;
+  portEXIT_CRITICAL(&wanProbeMux);
+  return InternetProbe::widok(true, now, stan, czas);
+}
