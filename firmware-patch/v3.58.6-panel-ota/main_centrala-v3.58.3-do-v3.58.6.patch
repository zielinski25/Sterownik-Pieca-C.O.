+  char proba[17] = "";
+  char powod[16] = "";
+  char czeka[16] = "";
+  uint32_t odmowaNr = 0;
+  bool jestOdmowa = false;
+  if (request->hasParam("panel_obraz")) {
+    const String v = request->getParam("panel_obraz")->value();
+    if (panelOtaObrazPoprawny(v.c_str())) memcpy(obraz, v.c_str(), sizeof(obraz));
+  }
+  if (request->hasParam("panel_obraz_proba")) {
+    const String v = request->getParam("panel_obraz_proba")->value();
+    if (panelOtaObrazPoprawny(v.c_str())) memcpy(proba, v.c_str(), sizeof(proba));
+  }
+  if (request->hasParam("panel_ota_odmowa")) {
+    const String v = request->getParam("panel_ota_odmowa")->value();
+    jestOdmowa = panelOtaCzytajOdmowe(v.c_str(), &odmowaNr, powod, sizeof(powod));
+  }
+  if (request->hasParam("panel_ota_czeka")) {
+    const String v = request->getParam("panel_ota_czeka")->value();
+    panelOtaCzytajSlowo(v.c_str(), czeka, sizeof(czeka));
+  }
+  const PanelOtaZgloszenie z = {wersja.c_str(), obraz, proba, jestOdmowa, odmowaNr, czeka};
+  const uint32_t teraz = millis();
+  bool probaNowa = false;
+  portENTER_CRITICAL(&g_panelOtaMux);
+  panelOtaPanelZglosil(g_panelOtaPanel, z, teraz);
+  const bool probaPrzed = g_panelOta.probaZgloszona;
+  const PanelOtaStan przed = g_panelOta;
+  const PanelOtaWynik w = panelOtaPoZgloszeniu(g_panelOta, z);
+  probaNowa = (!probaPrzed && g_panelOta.probaZgloszona);
+  if (w != PANEL_OTA_BEZ_ZMIAN) panelOtaZapamietajDoWykonania(w, przed, powod);
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (probaNowa) {
+    zapiszLog(String(F("tag=OTA-PANEL lvl=INFO zdarzenie=panel_startuje_z_nowego_pliku obraz=")) + proba);
+  }
+}
+
+// GET /panel-ota.bin?token=<haslo OTA> - plik dla panelu. Kody odpowiedzi:
+//   200 plik, 401 zle haslo, 404 nie ma oferty (albo pliku), 503 trwa alarm,
+//   409 panel zaczynal pobierac za duzo razy (oferta zostaje wycofana).
+static void panelOtaKlejPlik(AsyncWebServerRequest *request) {
+  String token;
+  if (request->hasParam("token")) token = request->getParam("token")->value();
+  if (token != String(OTA_HASLO)) {
+    request->send(401, "text/plain", "Bledne haslo OTA");
+    return;
+  }
+  const bool alarm = panelOtaAlarmTeraz();
+  const uint32_t teraz = millis();
+  PanelOtaWynik w = PANEL_OTA_BEZ_ZMIAN;
+  uint32_t nr = 0;
+  portENTER_CRITICAL(&g_panelOtaMux);
+  const PanelOtaStan przed = g_panelOta;
+  const int kod = panelOtaStartPobierania(g_panelOta, teraz, alarm, &w);
+  nr = g_panelOta.nr;
+  if (w != PANEL_OTA_BEZ_ZMIAN) panelOtaZapamietajDoWykonania(w, przed, "");
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (kod != 200) {
+    request->send(kod, "text/plain",
+                  kod == 404 ? "Brak oferty aktualizacji panelu"
+                  : kod == 503 ? "Alarm - aktualizacja panelu wstrzymana"
+                  : "Za duzo pobran - oferta wycofana");
+    return;
+  }
+  if (!systemFS196.exists("/panel_firmware.bin")) {
+    // Oferta jest, a pliku nie ma (np. skasowany w menedzerze plikow). Panel
+    // policzy to jako nieudana probe; po trzech zglosi odmowe i oferta zniknie.
+    portENTER_CRITICAL(&g_panelOtaMux);
+    panelOtaKoniecPobierania(g_panelOta, nr);
+    portEXIT_CRITICAL(&g_panelOtaMux);
+    zapiszLog(F("tag=OTA-PANEL lvl=ERR zdarzenie=brak_pliku_dla_panelu plik=/panel_firmware.bin"));
+    request->send(404, "text/plain", "Brak pobranego firmware panelu");
+    return;
+  }
+  // Koniec wysylania (calosc poszla albo panel sie rozlaczyl).
+  request->onDisconnect([nr]() {
+    portENTER_CRITICAL(&g_panelOtaMux);
+    panelOtaKoniecPobierania(g_panelOta, nr);
+    portEXIT_CRITICAL(&g_panelOtaMux);
+  });
+  request->send(systemFS196, "/panel_firmware.bin", "application/octet-stream");
+}
+
+// true = plik jest wlasnie wysylany panelowi. W tym czasie nie wolno go
+// podmienic (/update_panel) ani restartowac centrali (/update).
+static bool panelOtaKlejTransferTrwa() {
+  const uint32_t teraz = millis();
+  portENTER_CRITICAL(&g_panelOtaMux);
+  const bool trwa = panelOtaTransferTrwa(g_panelOta, teraz);
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  return trwa;
+}
+
+// ---------------------------------------------------------------------------
+// STOS ZADANIA TELEGRAMA. Funkcje ponizej dzialaja w tgTaskFn(): 8 kB stosu, a
+// pod kazda wysylka jest jeszcze polaczenie TLS. Wedlug logow tej centrali
+// (hwm_tg w HEALTH-A, opis v3.56.7 na gorze pliku) w najgorszej chwili zostaje
+// tam 2256-2708 B, a v3.31.23 naprawiala awarie po buforze 3,6 kB na tym samym
+// stosie. Dlatego:
+//   - teksty (480 B) i kopie stanu (320 B) leza w pamieci ze sterty
+//     (PanelOtaKlejRobocze), nie na stosie;
+//   - kazde wywolanie, ktore laczy sie z siecia (sendTelegramMessage(),
+//     sprawdzNajnowszaWersjeGithub(), pobierzFirmwarePanelaZGithub()), wychodzi
+//     z funkcji, ktora trzyma na stosie najwyzej kilka obiektow String;
+//     skladanie dluzszych tekstow jest w osobnych funkcjach (noinline), ktore
+//     wracaja PRZED wysylka.
+// Do 3.58.5 wysylki komendy /update_panel szly wprost z tgTaskFn().
+// ---------------------------------------------------------------------------
+struct PanelOtaKlejRobocze {
+  PanelOtaDoWykonania d;            // decyzja do wykonania
+  PanelOtaStan        oferta;       // kopia stanu oferty
+  PanelOtaPanel       panel;        // kopia tego, co wiadomo o panelu
+  char                tekst[480];   // linia logu, a po niej wiadomosc dla uzytkownika ("" = brak)
+};
+
+// Wyzerowana pamiec robocza albo nullptr, gdy sterta odmowi. Zwalnia wolajacy: free().
+static PanelOtaKlejRobocze *panelOtaKlejRoboczeWez() {
+  return (PanelOtaKlejRobocze *)calloc(1, sizeof(PanelOtaKlejRobocze));
+}
+
+// Koniec oferty (r.d): sprzatniecie NVS, wpis w logu i wiadomosc w r.tekst.
+// Wysyla ja wolajacy.
+static void panelOtaKlejWykonaj(PanelOtaKlejRobocze &r) {
+  const PanelOtaDoWykonania &d = r.d;
+  // Po restarcie centrali ta oferta ma juz nie wracac. Znacznik w NVS zostaje
+  // tylko wtedy, gdy nalezy juz do NASTEPNEJ oferty (wynik poprzedniej
+  // przyszedl z obslugi HTTP w chwili, gdy /update_panel wystawialo nowa).
+  portENTER_CRITICAL(&g_panelOtaMux);
+  const bool jestNastepna = g_panelOta.aktywna && g_panelOta.nr != d.przed.nr;
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (!jestNastepna) config.putBool("panOtaGotowa", false);
+  const bool pomyslnie = (d.wynik == PANEL_OTA_POTWIERDZONO_OBRAZ || d.wynik == PANEL_OTA_POTWIERDZONO_WERSJA ||
+                          d.wynik == PANEL_OTA_ANULOWANO);
+  snprintf(r.tekst, sizeof(r.tekst),
+           "tag=OTA-PANEL lvl=%s zdarzenie=%s nr=%lu wydanie=%s obraz=%s wersja_panelu=%s pobran=%u powod_panelu=%s",
+           pomyslnie ? "INFO" : "WARN", panelOtaWynikNazwa(d.wynik), (unsigned long)d.przed.nr, d.przed.tag, d.przed.obraz,
+           d.wersja[0] != '\0' ? d.wersja : "-", (unsigned)d.przed.pobranZaczetych, d.powod[0] != '\0' ? d.powod : "-");
+  zapiszLog(String(r.tekst));
+  panelOtaKomunikat(d.wynik, d.przed, d.wersja, d.powod, r.tekst, sizeof(r.tekst));
+}
+
+// Przypomnienie "panel jeszcze nie zaczal" (r.oferta, r.panel): wpis w logu
+// i wiadomosc w r.tekst. Wysyla ja wolajacy.
+static void panelOtaKlejPrzypomnij(PanelOtaKlejRobocze &r, uint32_t teraz, bool alarm) {
+  snprintf(r.tekst, sizeof(r.tekst),
+           "tag=OTA-PANEL lvl=WARN zdarzenie=panel_nie_zaczal nr=%lu kontakt=%d podaje_obraz=%d czeka=%s alarm=%d",
+           (unsigned long)r.oferta.nr, panelOtaPanelWKontakcie(r.panel, teraz) ? 1 : 0, r.panel.podajeObraz ? 1 : 0,
+           r.panel.czeka[0] != '\0' ? r.panel.czeka : "-", alarm ? 1 : 0);
+  zapiszLog(String(r.tekst));
+  panelOtaTekstPrzypomnienia(r.oferta, r.panel, teraz, alarm, r.panel.wersja, r.tekst, sizeof(r.tekst));
+}
+
+// Kazdy obieg zadania Telegrama (co kilka sekund): zalegla decyzja z obslugi
+// HTTP, limit czasu oferty, jedno przypomnienie.
+static void panelOtaKlejOkresowo() {
+  // Zwykly stan - nie ma oferty i nic nie czeka na wykonanie - konczy sie tutaj.
+  portENTER_CRITICAL(&g_panelOtaMux);
+  const bool jestCoRobic = g_panelOtaDoWykonania.jest || g_panelOta.aktywna;
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (!jestCoRobic) return;
+  PanelOtaKlejRobocze *r = panelOtaKlejRoboczeWez();
+  if (r == nullptr) return;   // brak pamieci: nic nie zostalo zmienione, nastepny obieg sprobuje znowu
+  const uint32_t teraz = millis();
+  const bool alarm = panelOtaAlarmTeraz();
+  bool przypomnij = false;
+  portENTER_CRITICAL(&g_panelOtaMux);
+  if (!g_panelOtaDoWykonania.jest) {
+    r->oferta = g_panelOta;   // stan sprzed decyzji
+    const PanelOtaWynik w = panelOtaPoCzasie(g_panelOta, teraz);
+    if (w != PANEL_OTA_BEZ_ZMIAN) panelOtaZapamietajDoWykonania(w, r->oferta, "");
+  }
+  r->d = g_panelOtaDoWykonania;
+  g_panelOtaDoWykonania.jest = false;
+  if (!r->d.jest) przypomnij = panelOtaCzasNaPrzypomnienie(g_panelOta, teraz);
+  r->oferta = g_panelOta;
+  r->panel = g_panelOtaPanel;
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (r->d.jest) panelOtaKlejWykonaj(*r);
+  else if (przypomnij) panelOtaKlejPrzypomnij(*r, teraz, alarm);
+  if (r->tekst[0] != '\0') sendTelegramMessage(String(r->tekst));
+  free(r);
+}
+
+// /update_panel_anuluj (Telegram: komenda i przycisk; Firebase: "update_panel_anuluj").
+static void panelOtaKlejKomendaAnuluj() {
+  panelOtaKlejOkresowo();   // najpierw to, co juz sie rozstrzygnelo
+  PanelOtaKlejRobocze *r = panelOtaKlejRoboczeWez();
+  if (r == nullptr) {
+    sendTelegramMessage(F("Centrali zabraklo pamieci - nic nie zostalo anulowane. Wyslij /update_panel_anuluj jeszcze raz."));
+    return;
+  }
+  portENTER_CRITICAL(&g_panelOtaMux);
+  r->d.przed = g_panelOta;
+  r->d.wynik = panelOtaAnuluj(g_panelOta);
+  memcpy(r->d.wersja, g_panelOtaPanel.wersja, sizeof(r->d.wersja));
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (r->d.wynik == PANEL_OTA_BEZ_ZMIAN) {
+    free(r);
+    sendTelegramMessage(F("Nie ma czego anulowac - zadna aktualizacja panelu nie czeka."));
+    return;
+  }
+  r->d.jest = true;
+  panelOtaKlejWykonaj(*r);
+  if (r->tekst[0] != '\0') sendTelegramMessage(String(r->tekst));
+  free(r);
+}
+
+// /update_panel, czesc przed pobieraniem: czy panel juz ma te wersje i
+// wycofanie poprzedniej oferty. W `tekst` zostawia wiadomosc dla uzytkownika
+// (wysyla ja wolajacy); true = pobierac plik z GitHuba.
+static __attribute__((noinline)) bool panelOtaKlejAktualizujPrzed(const String &tag, String &tekst) {
+  char wersjaPanelu[sizeof(g_panelOtaPanel.wersja)];
+  portENTER_CRITICAL(&g_panelOtaMux);
+  memcpy(wersjaPanelu, g_panelOtaPanel.wersja, sizeof(wersjaPanelu));
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (wersjaPanelu[0] != '\0' && tag == wersjaPanelu) {
+    tekst = "Panel juz ma najnowsza wersje (" + tag + "). Nic do zrobienia.";
+    return false;
+  }
+  // Poprzednia oferta znika PRZED podmiana pliku na dysku: od tej chwili
+  // /panel-ota.bin odpowiada 404, wiec panel nie zacznie pobierac pliku, ktory
+  // za moment zostanie usuniety. Jesli panel zdazyl zaczac - czekamy.
+  bool transfer = false;
+  bool bylaOferta = false;
+  uint32_t poprzedniNr = 0;
+  char poprzedniTag[sizeof(g_panelOta.tag)] = "";
+  const uint32_t teraz = millis();
+  portENTER_CRITICAL(&g_panelOtaMux);
+  transfer = panelOtaTransferTrwa(g_panelOta, teraz);
+  if (!transfer) {
+    poprzedniNr = g_panelOta.nr;
+    memcpy(poprzedniTag, g_panelOta.tag, sizeof(poprzedniTag));
+    bylaOferta = (panelOtaAnuluj(g_panelOta) == PANEL_OTA_ANULOWANO);
+  }
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (transfer) {
+    tekst = F("Panel wlasnie zaczal pobierac plik z centrali. Poczekaj na wynik (do kilku minut) i dopiero wtedy wyslij /update_panel ponownie.");
+    return false;
+  }
+  tekst = "Wydanie " + tag + ": pobieram plik panelu na centrale...";
+  if (bylaOferta) {
+    config.putBool("panOtaGotowa", false);
+    zapiszLog(String(F("tag=OTA-PANEL lvl=INFO zdarzenie=oferta_zastapiona nr=")) + String((unsigned long)poprzedniNr) +
+              " wydanie=" + poprzedniTag);
+    tekst += " Poprzednia, niewgrana oferta (wydanie " + String(poprzedniTag) + ") zostaje zastapiona.";
+  }
+  return true;
+}
+
+// /update_panel, czesc po pobraniu pliku: oferta dla panelu. W `tekst`
+// zostawia wiadomosc dla uzytkownika (wysyla ja wolajacy).
+static __attribute__((noinline)) void panelOtaKlejAktualizujPo(const String &tag, const PanelOtaSkan &skan, size_t rozmiar,
+                                                               String &tekst) {
+  char obraz[17];
+  panelOtaSkanObraz(skan, obraz);
+  uint32_t nr = config.getUInt("panOtaNr", 0U) + 1U;
+  if (nr == 0U || nr > 999999999UL) nr = 1U;   // panel odsyla numer jako najwyzej 9 cyfr
+  char wersjaPanelu[sizeof(g_panelOtaPanel.wersja)];
+  const uint32_t teraz = millis();
+  bool juzMa = false;
+  portENTER_CRITICAL(&g_panelOtaMux);
+  memcpy(wersjaPanelu, g_panelOtaPanel.wersja, sizeof(wersjaPanelu));
+  juzMa = panelOtaPanelMaObraz(g_panelOtaPanel, obraz, teraz);
+  if (!juzMa) panelOtaWystaw(g_panelOta, nr, tag.c_str(), obraz, (uint32_t)rozmiar, wersjaPanelu, teraz);
+  portEXIT_CRITICAL(&g_panelOtaMux);
+  if (juzMa) {
+    zapiszLog(String(F("tag=OTA-PANEL lvl=INFO zdarzenie=panel_juz_ma_ten_plik wydanie=")) + tag + " obraz=" + obraz);
+    tekst = "Panel juz pracuje na pliku z wydania " + tag + " (zglasza wersje " + String(wersjaPanelu) +
+            "). Nie ma czego aktualizowac.";
+    return;
+  }
+  config.putUInt("panOtaNr", nr);
+  config.putString("panOtaObraz", String(obraz));
+  config.putUInt("panOtaRozm", (uint32_t)rozmiar);
+  config.putString("panOtaPrzed", String(wersjaPanelu));
+  config.putBool("panOtaGotowa", true);   // na koncu: od tej chwili oferta wraca po restarcie centrali
+  zapiszLog(String(F("tag=OTA-PANEL lvl=INFO zdarzenie=oferta_wystawiona nr=")) + String((unsigned long)nr) + " wydanie=" + tag +
+            " obraz=" + obraz + " rozmiar=" + String((unsigned long)rozmiar));
+  tekst = "Plik panelu z wydania " + tag + " jest na centrali (" + String((unsigned long)rozmiar) + " B). "
+          "Panel z firmware v1.4.0 lub nowszym pobierze go sam, zwykle w ciagu minuty - gdy nie ma alarmu "
+          "i nikt nie dotyka ekranu; na ekranie pojawi sie napis AKTUALIZACJA PANELU. "
+          "Starszy panel zacznie dopiero po wylaczeniu i wlaczeniu. "
+          "Wynik przyjdzie osobna wiadomoscia. Oferta czeka 24 h; anulowanie: /update_panel_anuluj";
+}
+
+// /update_panel - po sprawdzeniu alarmu i otaOperacjaWTrakcie (case TG_UPDATE_PANEL).
+static void panelOtaKlejKomendaAktualizuj() {
+  panelOtaKlejOkresowo();   // najpierw to, co juz sie rozstrzygnelo (np. potwierdzenie sprzed sekundy)
+  if (panelOtaKlejTransferTrwa()) {
+    sendTelegramMessage(F("Panel wlasnie pobiera plik z centrali. Poczekaj na wynik (do kilku minut) i dopiero wtedy wyslij /update_panel ponownie."));
+    return;
+  }
+  sendTelegramMessage(F("Sprawdzam najnowsza wersje panelu na GitHub..."));
+  String tag, blad, tekst;
+  if (!sprawdzNajnowszaWersjeGithub(tag, blad)) {
+    sendTelegramMessage("Nie udalo sie sprawdzic wersji: " + blad);
+    return;
+  }
+  const bool pobierac = panelOtaKlejAktualizujPrzed(tag, tekst);
+  // Wynik poprzedniej oferty mogl przyjsc od panelu w trakcie pytania GitHuba:
+  // jego wiadomosc idzie przed wiadomoscia o nowym pliku. (Po wycofaniu
+  // poprzedniej oferty nowa decyzja juz nie powstanie.)
+  panelOtaKlejOkresowo();
+  sendTelegramMessage(tekst);
+  if (!pobierac) return;
+
+  // otaOperacjaWTrakcie tylko na czas pobierania z GitHuba (blokuje /update i
+  // drugie /update_panel). Do 3.58.5 flaga zostawala ustawiona az do
+  // potwierdzenia przez panel - czyli bez ograniczenia czasu, a razem z nia
+  // stal nadzor zadan. Znaczniki w NVS jak dotad: gdyby centrala zrestartowala
+  // sie w trakcie pobierania, setup() powie o tym uzytkownikowi.
+  otaOperacjaWTrakcie = true;
+  config.putBool("panOtaTrwa", true);
+  config.putString("panOtaTag", tag);
+  PanelOtaSkan skan;
+  size_t rozmiar = 0;
+  blad = "";
+  const bool pobrano = pobierzFirmwarePanelaZGithub(tag, blad, skan, rozmiar);
+  otaOperacjaWTrakcie = false;
+  config.putBool("panOtaTrwa", false);
+  if (!pobrano) {
+    sendTelegramMessage("Pobieranie firmware panelu nieudane: " + blad);
+    return;
+  }
+  panelOtaKlejAktualizujPo(tag, skan, rozmiar, tekst);
+  sendTelegramMessage(tekst);
+}
+
+// Koniec setup(), czesc bez sieci: oferta, ktora czekala, gdy centrala sie
+// zrestartowala. true = w `tekst` jest wiadomosc dla uzytkownika.
+static __attribute__((noinline)) bool panelOtaKlejPoStarcieStan(String &tekst) {
+  const bool nvsGotowa = config.getBool("panOtaGotowa", false);
+  const bool nvsTrwa = config.getBool("panOtaTrwa", false);
+  const String nvsTag = config.getString("panOtaTag", "");
+  if (nvsGotowa) {
+    const String nvsObraz = config.getString("panOtaObraz", "");
+    const String nvsPrzed = config.getString("panOtaPrzed", "");
+    const uint32_t nvsRozmiar = config.getUInt("panOtaRozm", 0U);
+    const uint32_t nvsNr = config.getUInt("panOtaNr", 0U);
+    // Plik musi byc tym samym, ktory byl oferowany: zgodny rozmiar, a
+    // identyfikator obrazu panel i tak porowna z koncem pobranego pliku.
+    const bool plikJest = (nvsRozmiar > 0U && (uint32_t)g_panelFirmwareSize == nvsRozmiar);
+    if (nvsNr > 0U && plikJest && panelOtaObrazPoprawny(nvsObraz.c_str())) {
+      const uint32_t teraz = millis();
+      portENTER_CRITICAL(&g_panelOtaMux);
+      panelOtaWystaw(g_panelOta, nvsNr, nvsTag.c_str(), nvsObraz.c_str(), nvsRozmiar, nvsPrzed.c_str(), teraz);
+      portEXIT_CRITICAL(&g_panelOtaMux);
+      zapiszLog(String(F("tag=OTA-PANEL lvl=INFO zdarzenie=przywrocono_oferte_po_restarcie nr=")) + String((unsigned long)nvsNr) +
+                " wydanie=" + nvsTag + " obraz=" + nvsObraz);
+      tekst = "Centrala zrestartowala sie, a aktualizacja panelu (plik z wydania " + nvsTag +
+              ") jeszcze nie zostala wgrana - oferta wraca na kolejne 24 h. Anulowanie: /update_panel_anuluj";
+    } else {
+      // Zapis sprzed 3.58.6 (bez identyfikatora pliku) albo plik zniknal.
+      config.putBool("panOtaGotowa", false);
+      zapiszLog(String(F("tag=OTA-PANEL lvl=WARN zdarzenie=oferta_nie_do_przywrocenia wydanie=")) + nvsTag +
