+    wlaczony = p.getBool("fs_on", true);
+    p.end();
+  }
+  g_histFsZapisWlaczony.store(wlaczony, std::memory_order_release);
+  Serial.printf("tag=HIST-FS lvl=INFO zdarzenie=start zapis_na_flash=%s\n", wlaczony ? "WL" : "WYL");
+}
