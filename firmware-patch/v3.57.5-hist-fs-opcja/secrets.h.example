#pragma once
// =====================================================================
//  secrets.h  —  TWOJE HASLA. TEN PLIK NIE IDZIE DO GITA.
// =====================================================================
//
//  JAK ZACZAC (3 kroki):
//    1. Skopiuj ten plik i zmien nazwe kopii z "secrets.h.example" na "secrets.h"
//    2. Otworz "secrets.h" i wpisz swoje hasla w miejsce tekstu w cudzyslowiu
//    3. Zapisz. Plik "secrets.h" jest w .gitignore — git go nie widzi.
//
//  UWAGA: haslo WiFi musi miec MINIMUM 8 znakow (wymog WPA2).
//
//  Ten plik (.example) JEST w gicie i sluzy tylko jako wzor.
//  Nie wpisuj tu prawdziwych hasel — on idzie na GitHub.
// =====================================================================

// ----- 1. PUNKT DOSTEPOWY (siec, ktora rozglasza centrala) ------------
#define SECRET_WIFI_AP_SSID     "PiecCO_AP"
#define SECRET_WIFI_AP_PASSWORD "ZMIEN-MNIE-NA-SWOJE"      // min. 8 znakow

// ----- 2. WGRYWANIE FIRMWARE (OTA) ------------------------------------
// Haslo do wgrywania z aplikacji i z przegladarki.
#define SECRET_OTA_HASLO        "ZMIEN-MNIE-NA-SWOJE-OTA"

// ----- 3. KONTO FIREBASE ----------------------------------------------
// Centrala loguje sie tym do bazy przy starcie. Bez tego nie ma zdalnego
// dostepu. Jesli NIE MASZ jeszcze wlasnego hasla — wpisz obecne, a potem
// zmien je w konsoli Firebase i tutaj.
#define SECRET_FIREBASE_PASS    "ZMIEN-MNIE-NA-SWOJE-FB"

// ----- 4. TOKEN KOMEND -------------------------------------------------
// Token, ktorym aplikacja/panel podpisuje polecenia do pieca
// (pompa_wl, pompa_wyl, reset_alarmow, update_centrala...).
// Kto go zna i ma dostep do bazy — steruje piecem. Trzymaj poza gitem.
#define SECRET_CMD_TOKEN        "ZMIEN-MNIE-NA-SWOJ-TOKEN"

// ----- 5. TOKEN POBRANIA HISTORII -------------------------------------
// Token do pobrania plikow historii przez HTTP (/history, /history/long).
// Bez niego te dwa adresy sa ZAMKNIETE (503). Token jedzie w naglowku
// "Authorization: Bearer <token>". Minimum 32 znaki, inne niz pozostale.
// Wpisz tu wlasny, losowy ciag; nie wklejaj go do gita ani na czat.
#define SECRET_HISTORIA_TOKEN   "ZMIEN-MNIE-NA-DLUGI-LOSOWY-TOKEN-32-ZNAKI"
